# Copy to .env.local or export these before ./start.sh.
# All paths can also be edited directly in the web UI.

# Web harness bind address.
LOCOMO_EVAL_HOST=127.0.0.1
LOCOMO_EVAL_PORT=19181

# Project and dataset paths.
LOCOMO_EVAL_REPO=/path/to/locomo-eval-web
# Default bundled path. If dataset/full/locomo.json exists, the web app will prefer it automatically.
LOCOMO_DATA=dataset/locomo10.json
LONGMEMEVAL_DATA=/path/to/longmemeval_s_cleaned.json

# Local run workspace. Leave empty to use ./runs.
LOCOMO_EVAL_WORKSPACE=/path/to/local_eval_workspace

# Optional OpenViking integration.
OPENVIKING_SOURCE=/path/to/openviking
OPENVIKING_PYTHON=/path/to/python
LOCOMO_EVAL_OPENVIKING_WORKSPACE=/path/to/openviking_workspace

# Judge API configuration.
JUDGE_BASE_URL=https://example.com/v1
JUDGE_MODEL=gpt-5.5
JUDGE_TOKEN=your-token
