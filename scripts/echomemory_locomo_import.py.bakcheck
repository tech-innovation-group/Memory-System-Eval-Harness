MEMORY_ARTIFACT_CACHE_TTL_S = 1.0
_MEMORY_ARTIFACT_CACHE: dict[tuple[str, str], tuple[float, dict[str, Any]]] = {}
WORKSPACE_TOKEN_USAGE_CACHE_TTL_S = 5.0
