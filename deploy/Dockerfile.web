FROM python:3.11-slim

WORKDIR /web
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

COPY deploy/web-requirements.txt /tmp/web-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/web-requirements.txt
COPY deploy/web_app_server.py /web/app.py
COPY deploy/templates /web/templates
COPY stress/generic /web/stress/generic
COPY stress/echomem/formal_progress.py /web/stress/echomem/formal_progress.py

CMD ["waitress-serve", "--host=0.0.0.0", "--port=8081", "app:app"]
