# Copy to /opt/memory-eval-web/server.env and fill secrets.
# Never commit the copied file.

WEB_DATA_DIR=/data
RESULTS_DIR=/opt/memory-eval-harness/results
HOST_RESULTS_DIR=/opt/memory-eval-harness/results
RESULT_ARCHIVE_DIR=/opt/memory-eval-harness/results/_archives
SOURCE_ROOT=/opt/memory-eval-sources
SOURCE_CACHE_ROOT=/opt/memory-eval-sources/_cache
ECHOMEM_WORKSPACE_CACHE=/opt/memory-eval-web/cache

DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_LLM_API_KEY=
DEFAULT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_EMBEDDING_MODEL=text-embedding-v3
# This must be a valid key for DEFAULT_EMBEDDING_BASE_URL; do not reuse a
# chat-only DeepSeek key.
DEFAULT_EMBEDDING_API_KEY=

ECHOMEM_AUTO_COMMIT_THRESHOLD=20000
ECHOMEM_ATOMIC_EXTRACTION_TEMPERATURE=0.7
ECHOMEM_CONFIG_REVISION=1
EVAL_IMAGE=memory-eval-runner:local
RUN_UID=1000
RUN_GID=1000
RESULT_RETENTION_DAYS=3
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_BASE_URL=http://127.0.0.1:8081

# Optional GitHub and Feishu integration.
GITHUB_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_UPLOAD_USER=pr测试机器人
FEISHU_UPLOAD_NOTE=
SESSION_SECRET=change-this-secret
