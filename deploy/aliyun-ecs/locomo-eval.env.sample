# Copy to /opt/locomo/locomo-eval-web/.env.production and edit in place.
# Keep this file server-local. Do not commit real secrets.

export LOCOMO_EVAL_HOST=127.0.0.1
export LOCOMO_EVAL_PORT=19181

export LOCOMO_EVAL_REPO=/opt/locomo/locomo-eval-web
export LOCOMO_EVAL_WORKSPACE=/opt/locomo/locomo-eval-web/runs
export LOCOMO_DATA=/opt/locomo/locomo-eval-web/dataset/locomo10.json
export LONGMEMEVAL_DATA=/opt/locomo/locomo-eval-web/dataset/full/longmemeval_s_cleaned.json

export ECHOMEM_ROOT=/opt/locomo/echo_memory
export ECHOMEM_PYTHON=/opt/locomo/echo_memory/.venv/bin/python
export ECHOMEM_WORKSPACE=/data/echomem_workspace
export ECHOMEM_ACCOUNT=default
export ECHOMEM_USER_ID=default
export ECHOMEM_AGENT_ID=default

export DASHSCOPE_API_KEY=replace-me
export DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

export ECHOMEM_CHAT_PROVIDER=deepseek
export ECHOMEM_CHAT_MODEL=gpt-5.5
export ECHOMEM_CHAT_API_KEY=replace-me
export ECHOMEM_CHAT_BASE_URL=https://your-chat-provider.example.com/v1

export JUDGE_BASE_URL=https://your-judge-provider.example.com/v1
export JUDGE_MODEL=gpt-5.5
export JUDGE_TOKEN=replace-me
