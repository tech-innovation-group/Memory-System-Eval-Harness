}

.readiness-card p,
.readiness-card li {
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.readiness-card p {
  margin: 0;
}

.readiness-card ul {
  display: grid;
  gap: 5px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.readiness-card li {
  padding: 6px 8px;
  border-radius: 5px;
  background: #f7f9fd;
}

.acceptance-matrix-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.acceptance-card {
  display: grid;
  gap: 8px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dfe7f1;
  border-left: 4px solid #94a3b8;
  border-radius: 7px;
  background: #ffffff;
}

.acceptance-card.hero {
  grid-column: span 2;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  background: #fbfcfe;
}

.acceptance-card.next {
  background: #fbfcfe;
}

.acceptance-card.ok {
  border-left-color: #2f8f6b;
}

.acceptance-card.warn {
  border-left-color: #c48a1d;
}

.acceptance-card.bad {
  border-left-color: #c94f4f;
}

.acceptance-card.muted {
  border-left-color: #94a3b8;
}

.acceptance-card > span,
.acceptance-card .preflight-card-head span {
  color: #667790;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.acceptance-card strong,
.acceptance-card p,
.acceptance-card li,
.acceptance-card code {
  min-width: 0;
  overflow-wrap: anywhere;
}

.acceptance-card strong {
  color: #10233f;
  font-size: 14px;
  line-height: 1.45;
}

.acceptance-card p,
.acceptance-card li {
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.acceptance-card p {
  margin: 0;
}

.acceptance-card code {
  display: block;
  max-height: 92px;
  padding: 7px 8px;
  overflow: auto;
  border: 1px solid #e6edf6;
  border-radius: 5px;
  background: #f7f9fd;
  color: #2f415f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.45;
  white-space: pre-wrap;
}

.acceptance-card ul {
  display: grid;
  gap: 5px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.acceptance-card li {
  padding: 6px 8px;
  border-radius: 5px;
  background: #f7f9fd;
}

.smoke-plan-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.smoke-plan-card {
  display: grid;
  gap: 9px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dfe7f1;
  border-left: 4px solid #94a3b8;
  border-radius: 7px;
  background: #ffffff;
}

.smoke-plan-card.hero {
  grid-column: span 2;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  background: #fbfcfe;
}

.smoke-plan-card.examples,
.smoke-plan-card.commands {
  grid-column: 1 / -1;
}

.smoke-plan-card.ok {
  border-left-color: #2f8f6b;
}

.smoke-plan-card.warn,
.smoke-plan-card.todo {
  border-left-color: #c48a1d;
}

.smoke-plan-card.bad {
  border-left-color: #c94f4f;
}

.smoke-plan-card.muted {
  border-left-color: #94a3b8;
}

.smoke-plan-card > span,
.smoke-plan-card .preflight-card-head span {
  color: #667790;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.smoke-plan-card strong,
.smoke-plan-card p,
.smoke-plan-card code,
.smoke-plan-card dt,
.smoke-plan-card dd,
.smoke-plan-card small,
.smoke-plan-card span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.smoke-plan-card strong {
  color: #10233f;
  font-size: 14px;
  line-height: 1.45;
}

.smoke-plan-card p,
.smoke-plan-card dt,
.smoke-plan-card dd,
.smoke-plan-card small {
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.smoke-plan-card p {
  margin: 0;
}

.smoke-plan-card code {
  display: inline-block;
  max-width: 100%;
  padding: 2px 5px;
  border-radius: 4px;
  background: #f7f9fd;
  color: #2f415f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.45;
  vertical-align: middle;
}

.smoke-plan-kv {
  display: grid;
  grid-template-columns: 82px minmax(0, 1fr);
  gap: 6px 10px;
  margin: 0;
}

.smoke-plan-kv dt {
  font-weight: 800;
}

.smoke-plan-kv dd {
  margin: 0;
}

.smoke-plan-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.smoke-plan-actions > span {
  color: #667790;
  font-size: 11px;
  font-weight: 700;
}

.smoke-question-list {
  display: grid;
  gap: 8px;
}

.smoke-question-list section {
  display: grid;
  gap: 4px;
  padding: 9px;
  border: 1px solid #e6edf6;
  border-radius: 6px;
  background: #fbfcfe;
}

.smoke-question-list small {
  display: block;
}

.setup-pack-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.setup-pack-card {
  display: grid;
  gap: 10px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dfe7f1;
  border-left: 4px solid #94a3b8;
  border-radius: 7px;
  background: #ffffff;
}

.setup-pack-card.hero {
  grid-column: 1 / -1;
  background: #fbfcfe;
}

.setup-pack-card.ok {
  border-left-color: #2f8f6b;
}

.setup-pack-card.warn {
  border-left-color: #c48a1d;
}

.setup-pack-card.bad {
  border-left-color: #c94f4f;
}

.setup-pack-card.muted {
  border-left-color: #94a3b8;
}

.setup-pack-card > span,
.setup-pack-card .preflight-card-head span {
  color: #667790;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.setup-pack-card strong,
.setup-pack-card p,
.setup-pack-card li,
.setup-pack-card code,
.setup-pack-card pre {
  min-width: 0;
  overflow-wrap: anywhere;
}

.setup-pack-card strong {
  color: #10233f;
  font-size: 14px;
  line-height: 1.45;
}

.setup-pack-card p,
.setup-pack-card li {
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.setup-pack-card p {
  margin: 0;
}

.setup-pack-block {
  max-height: 260px;
  margin: 0;
  padding: 10px;
  overflow: auto;
  border: 1px solid #dfe7f1;
  border-radius: 6px;
  background: #f7f9fd;
  color: #10233f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.55;
  white-space: pre-wrap;
}

.setup-pack-command-list {
  display: grid;
  gap: 8px;
  min-width: 0;
}

.setup-pack-command {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: start;
  min-width: 0;
  padding: 9px;
  border: 1px solid #e6edf6;
  border-radius: 6px;
  background: #fbfcfe;
}

.setup-pack-command div {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.setup-pack-command code {
  display: block;
  color: #2f415f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.5;
  white-space: pre-wrap;
}

.setup-pack-list {
  display: grid;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.setup-pack-list li {
  padding: 7px 9px;
  border-radius: 5px;
  background: #f7f9fd;
}

.handoff-package-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.handoff-package-card {
  display: grid;
  gap: 10px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dfe7f1;
  border-left: 4px solid #94a3b8;
  border-radius: 7px;
  background: #ffffff;
}

.handoff-package-card.hero,
.handoff-package-card.commands {
  grid-column: 1 / -1;
  background: #fbfcfe;
}

.handoff-package-card.ok {
  border-left-color: #2f8f6b;
}

.handoff-package-card.warn {
  border-left-color: #c48a1d;
}

.handoff-package-card.bad {
  border-left-color: #c94f4f;
}

.handoff-package-card.muted {
  border-left-color: #94a3b8;
}

.handoff-package-card > span,
.handoff-package-card .preflight-card-head span {
  color: #667790;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.handoff-package-card strong,
.handoff-package-card p,
.handoff-package-card li,
.handoff-package-card code,
.handoff-package-card span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.handoff-package-card strong {
  color: #10233f;
  font-size: 14px;
  line-height: 1.45;
}

.handoff-package-card p,
.handoff-package-card li {
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.handoff-package-card p {
  margin: 0;
}

.handoff-package-list {
  display: grid;
  gap: 7px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.handoff-package-list li {
  display: grid;
  grid-template-columns: minmax(120px, 0.34fr) minmax(0, 1fr);
  gap: 8px;
  align-items: start;
  padding: 8px 9px;
  border-radius: 6px;
  background: #f7f9fd;
}

.handoff-package-list li.ok {
  background: #f2fbf7;
}

.handoff-package-list li.warn {
  background: #fff9ed;
}

.handoff-package-list li.bad {
  background: #fff1f2;
}

.handoff-package-list code,
.handoff-package-command code {
  color: #2f415f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.45;
}

.handoff-package-command-list {
  display: grid;
  gap: 8px;
  min-width: 0;
}

.handoff-package-command {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: start;
  min-width: 0;
  padding: 9px;
  border: 1px solid #e6edf6;
  border-radius: 6px;
  background: #ffffff;
}

.handoff-package-command div {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.handoff-package-command code {
  display: block;
  white-space: pre-wrap;
}

@media (max-width: 980px) {
  .readiness-panel,
  .handoff-dashboard-panel,
  .github-launch-panel,
  .handoff-audit-panel,
  .acceptance-matrix-panel,
  .smoke-plan-panel,
  .setup-pack-panel,
  .handoff-package-panel {
    grid-template-columns: 1fr;
  }

  .readiness-card.hero,
  .handoff-dashboard-card.hero,
  .github-launch-card.hero,
  .acceptance-card.hero,
  .smoke-plan-card.hero {
    grid-column: auto;
    grid-template-columns: 1fr;
  }

  .readiness-score {
    width: 100%;
    min-height: 72px;
  }

  .smoke-plan-card.examples,
  .smoke-plan-card.commands,
  .handoff-dashboard-card.commands,
  .github-launch-card.commands,
  .setup-pack-card.hero,
  .handoff-package-card.hero,
  .handoff-package-card.commands {
    grid-column: auto;
  }

  .setup-pack-command,
  .github-launch-command,
  .handoff-package-command,
  .handoff-package-list li {
    grid-template-columns: 1fr;
  }
}

.account-config-snapshot {
  display: grid;
  gap: 10px;
  min-width: 0;
}

.snapshot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  min-width: 0;
}

.snapshot-grid article,
.snapshot-note {
  min-width: 0;
  padding: 10px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #fbfcfe;
}

.snapshot-grid span,
.snapshot-grid code,
.snapshot-note strong,
.snapshot-note p {
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
}

.snapshot-grid span {
  color: #667790;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.snapshot-grid code {
  margin-top: 5px;
  color: #10233f;
  font-size: 12px;
  line-height: 1.55;
  white-space: normal;
}

.snapshot-note {
  background: #f6f9ff;
}

.snapshot-note strong {
  color: #10233f;
  font-size: 13px;
}

.snapshot-note p {
  margin-top: 5px;
  color: #53657f;
  font-size: 13px;
  line-height: 1.65;
}

.backend-isolation-summary {
  display: grid;
  gap: 10px;
  min-width: 0;
}

@media (max-width: 980px) {
  .backend-config-matrix {
    grid-template-columns: 1fr;
  }
}

.backend-isolation-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dbe3ef;
  border-left: 4px solid #4b7fbf;
  border-radius: 7px;
  background: #fbfdff;
}

.backend-isolation-hero.ok {
  border-left-color: #2f8f6b;
}

.backend-isolation-hero.warn {
  border-left-color: #c48a1d;
}

.backend-isolation-hero span,
.backend-isolation-grid span {
  display: block;
  color: #667790;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.backend-isolation-hero strong,
.backend-isolation-grid strong,
.backend-isolation-grid code,
.backend-isolation-hero p,
.backend-isolation-grid p {
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
}

.backend-isolation-hero strong {
  margin-top: 4px;
  color: #10233f;
  font-size: 15px;
}

.backend-isolation-hero p,
.backend-isolation-grid p {
  margin-top: 5px;
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.backend-isolation-actions {
  display: flex;
  justify-content: flex-end;
}

.backend-isolation-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  min-width: 0;
}

.backend-isolation-grid article {
  min-width: 0;
  padding: 10px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #ffffff;
}

.backend-isolation-grid strong,
.backend-isolation-grid code {
  margin-top: 5px;
  color: #10233f;
  font-size: 12px;
  line-height: 1.5;
  white-space: normal;
}

.account-isolation-matrix {
  display: grid;
  gap: 10px;
  min-width: 0;
}

.isolation-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.isolation-row {
  display: grid;
  gap: 10px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dfe7f1;
  border-left-width: 4px;
  border-radius: 7px;
  background: #ffffff;
}

.isolation-row.ok {
  border-left-color: #2f8f6b;
}

.isolation-row.warn {
  border-left-color: #c48a1d;
}

.isolation-row.bad {
  border-left-color: #c94f4f;
}

.isolation-row-head {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.isolation-row-head strong {
  min-width: 0;
  color: #10233f;
  overflow-wrap: anywhere;
}

.isolation-badge {
  flex: 0 1 auto;
  min-width: 0;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.isolation-badge.ok {
  color: #176347;
  background: #e9f7f1;
}

.isolation-badge.warn {
  color: #855d12;
  background: #fff6dc;
}

.isolation-badge.bad {
  color: #9f3030;
  background: #fff0f0;
}

.isolation-row dl {
  display: grid;
  grid-template-columns: minmax(96px, max-content) minmax(0, 1fr);
  gap: 6px 10px;
  min-width: 0;
  margin: 0;
}

.isolation-row dt {
  color: #667790;
  font-size: 11px;
  font-weight: 800;
}

.isolation-row dd {
  min-width: 0;
  margin: 0;
  color: #53657f;
  font-size: 12px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.isolation-row code,
.account-isolation-matrix code {
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.plugin-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.plugin-meta-row em {
  width: max-content;
  max-width: 100%;
  padding: 3px 8px;
  border-radius: 999px;
  background: #edf4ff;
  color: #164b9b;
  font-size: 11px;
  font-style: normal;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.plugin-capability-details {
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #ffffff;
}

.plugin-capability-details summary {
  color: #164b9b;
  cursor: pointer;
  font-size: 12px;
  font-weight: 850;
}

.plugin-capability-details[open] summary {
  margin-bottom: 8px;
}

.plugin-local-details {
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #fbfdff;
}

.plugin-local-details summary {
  color: #164b9b;
  cursor: pointer;
  font-size: 12px;
  font-weight: 850;
}

.plugin-local-details[open] summary {
  margin-bottom: 8px;
}

.plugin-capability-list {
  display: grid;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.plugin-capability-list li {
  display: grid;
  gap: 2px;
  min-width: 0;
  padding: 8px 10px;
  border-radius: 6px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
}

.plugin-capability-list strong,
.plugin-capability-list span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.plugin-capability-list strong {
  color: #10233f;
  font-size: 12px;
}

.plugin-capability-list span {
  color: #667790;
  font-size: 12px;
  line-height: 1.5;
}

.plugin-local-config {
  display: grid;
  gap: 10px;
  min-width: 0;
  margin-top: 4px;
  padding: 12px;
  border: 1px solid #dbe7f6;
  border-radius: 8px;
  background: #ffffff;
}

.plugin-local-head {
  display: grid;
  gap: 2px;
}

.plugin-local-head strong {
  color: #10233f;
  font-size: 13px;
}

.plugin-local-head span {
  color: #64748b;
  font-size: 12px;
}

.plugin-path-grid,
.plugin-config-files {
  display: grid;
  gap: 8px;
}

.plugin-path-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.plugin-path-grid article,
.plugin-config-files article {
  display: grid;
  gap: 4px;
  min-width: 0;
  padding: 8px;
  border: 1px solid #edf2f7;
  border-radius: 6px;
  background: #fbfdff;
}

.plugin-path-grid span,
.plugin-config-files span {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.plugin-path-grid code,
.plugin-config-files code {
  min-width: 0;
  color: #0f172a;
  font-size: 11px;
  white-space: normal;
  overflow-wrap: anywhere;
}

.plugin-config-files ul {
  display: grid;
  gap: 5px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.plugin-config-files li {
  display: grid;
  grid-template-columns: 110px minmax(0, 1fr);
  gap: 8px;
  align-items: start;
  min-width: 0;
}

.plugin-config-files li strong,
.plugin-config-files li span {
  min-width: 0;
  overflow-wrap: anywhere;
  text-transform: none;
}

.plugin-config-files li strong {
  color: #10233f;
  font-size: 12px;
}

.plugin-config-files li span {
  color: #64748b;
  font-size: 12px;
}

.chat-transcript,
.log-box,
.terminal {
  border-radius: 6px;
}

@media (max-width: 900px) {
  .workflow-guide {
    grid-template-columns: 1fr;
  }

  .workflow-step {
    border-right: 0;
    border-bottom: 1px solid #edf2f7;
  }

  .workflow-step:last-child {
    border-bottom: 0;
  }

  .detail-meta-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .diagnostic-grid {
    grid-template-columns: 1fr;
  }

  .account-topbar,
  .config-plugin-grid {
    grid-template-columns: 1fr;
  }

  .account-scope {
    max-width: none;
    min-width: 0;
  }
}

@media (max-width: 1180px) {
  .account-topbar {
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .account-control {
    grid-template-columns: auto minmax(128px, 0.8fr) minmax(180px, 1fr) repeat(2, max-content);
  }

  .account-scope {
    max-width: none;
  }

  .locomo-stage-grid,
  .support-link-grid,
  .plugin-path-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Progress bar pulse animation for commit phase */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

/* Compact app chrome for the in-app browser and smaller laptops. */
@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: hidden;
  }

  .app-sidebar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: auto;
    display: grid;
    grid-template-columns: minmax(150px, auto) minmax(110px, max-content);
    grid-template-rows: auto auto;
    gap: 8px 12px;
    padding: 10px 14px;
    border-right: 0;
    border-bottom: 1px solid #d7e0ec;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .brand-block {
    min-width: 0;
    padding: 0;
    border-bottom: 0;
  }

  .brand-block .label {
    font-size: 10px;
  }

  .brand-block strong {
    font-size: 15px;
  }

  .sidebar-status {
    justify-self: end;
    align-self: center;
    max-width: 180px;
    padding: 6px 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .side-nav {
    grid-column: 1 / -1;
    display: flex;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    padding: 2px 0 4px;
    scrollbar-width: thin;
  }

  .nav-group {
    display: contents;
  }

  .nav-group > span {
    align-self: center;
    padding: 0 6px;
    white-space: nowrap;
  }

  .nav-item {
    flex: 0 0 auto;
    width: auto;
    min-width: max-content;
    height: 34px;
    padding: 0 10px;
    font-size: 13px;
  }

  .nav-item.active {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .app-content {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: hidden;
    padding: 16px;
  }

  .view-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    margin-bottom: 12px;
    padding-bottom: 12px;
  }

  .hero-status {
    justify-content: flex-start;
    min-width: 0;
    padding-top: 0;
  }

  .workflow-guide {
    display: flex;
    flex-direction: row;
    gap: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-bottom: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
  }

  .workflow-step {
    flex: 0 0 174px;
    min-width: 174px;
    border-right: 1px solid #edf2f7;
    border-bottom: 0;
  }

  .workflow-step:last-child {
    border-right: 0;
  }

  .panel {
    padding: 18px;
  }

  .locomo-stage-grid,
  .support-link-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .account-topbar {
    gap: 8px;
    padding: 9px;
  }

  .account-control {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .account-control .label {
    grid-column: 1 / -1;
    align-self: center;
  }

  .account-control select {
    grid-column: 1 / -1;
    min-height: 36px;
  }

  .account-control input {
    grid-column: 1 / -1;
  }

  .account-control button {
    width: 100%;
    min-width: 0;
  }

  .workflow-guide {
    flex-direction: row;
    grid-template-columns: unset;
  }

  .locomo-stage-grid,
  .support-link-grid,
  .plugin-path-grid {
    grid-template-columns: 1fr;
  }

  .plugin-config-files li {
    grid-template-columns: 1fr;
  }
}

/* ===== Current App Shell Guardrails ===== */
.app-shell {
  width: 100%;
  margin: 0;
  padding: 0;
}

.app-shell .app-sidebar,
.app-shell .app-content,
.app-shell .account-topbar,
.app-shell .workflow-guide,
.app-shell .panel {
  min-width: 0;
}

.app-shell .app-content {
  justify-self: stretch;
}

.account-topbar {
  overflow: clip;
}

.account-control {
  display: flex;
  flex-wrap: wrap;
}

.account-control .label,
.account-control select,
.account-control input,
.account-control button {
  min-width: 0;
}

.account-scope {
  min-width: 0;
}

.account-scope strong,
.account-scope span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.workflow-guide {
  min-width: 0;
}

.workflow-step {
  min-width: 0;
}

.workflow-step > div {
  min-width: 0;
}

@media (max-width: 1180px) {
  .account-control {
    row-gap: 7px;
  }
}

@media (max-width: 980px) {
  .workflow-guide {
    display: flex;
    grid-template-columns: unset;
    gap: 0;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
  }

  .workflow-step {
    flex: 0 0 172px;
    border-right: 1px solid #edf2f7;
    border-bottom: 0;
  }

  .workflow-step:last-child {
    border-right: 0;
  }
}

@media (max-width: 900px) {
  .app-sidebar {
    grid-template-columns: minmax(0, 1fr) minmax(88px, auto);
  }

  .side-nav {
    overscroll-behavior-x: contain;
  }

  .nav-group > span {
    flex: 0 0 auto;
  }

  .account-topbar {
    grid-template-columns: 1fr;
  }

  .account-control {
    align-items: stretch;
  }

  .account-control button {
    flex: 1 1 120px;
    width: auto;
  }
}

@media (max-width: 680px) {
  .account-control {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .account-control .label,
  .account-control select,
  .account-control input {
    grid-column: 1 / -1;
  }

  .workflow-step {
    flex-basis: min(172px, 72vw);
  }
}

/* Final account bar layout: prevent long account/workspace labels from clipping. */
.account-topbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
  align-items: stretch;
  gap: 10px;
  overflow: visible;
}

.account-control {
  display: grid;
  grid-template-columns: max-content minmax(130px, 0.8fr) minmax(160px, 1fr) max-content max-content;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.account-control .label,
.account-control select,
.account-control input,
.account-control button {
  max-width: 100%;
}

.account-control select,
.account-control input {
  width: 100%;
}

.account-control button {
  min-width: 0;
  white-space: nowrap;
}

.account-scope {
  display: grid;
  align-content: start;
  gap: 4px;
  max-width: none;
  min-width: 0;
  overflow: hidden;
}

.account-scope strong,
.account-scope span,
.account-scope code {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.account-scope code {
  display: block;
  padding: 3px 6px;
  border: 1px solid #e1e8f1;
  border-radius: 5px;
  background: #f6f9fc;
  color: #39506f;
  font-size: 11px;
  line-height: 1.35;
}

@media (max-width: 1120px) {
  .account-topbar {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .account-control {
    grid-template-columns: 1fr 1fr;
  }

  .account-control .label,
  .account-control select,
  .account-control input {
    grid-column: 1 / -1;
  }

  .account-control button {
    width: 100%;
  }
}

@media (max-width: 520px) {
  .account-control {
    grid-template-columns: 1fr;
  }

  .account-control .label,
  .account-control select,
  .account-control input,
  .account-control button {
    grid-column: 1 / -1;
    width: 100%;
  }
}

/* Final overflow hardening for the account bar and dense workbench panes. */
.app-shell,
.app-content,
.view-panel,
.panel,
.agent-workbench,
.agent-sidebar,
.agent-chat-panel,
.memory-evidence,
.agent-card,
.form-grid,
.question-picker,
.dataset-category-panel,
.category-card-grid,
.category-card,
.snapshot-grid,
.backend-isolation-summary,
.backend-isolation-hero,
.backend-isolation-grid,
.isolation-grid,
.plugin-local-config,
.plugin-path-grid,
.path-row {
  min-width: 0;
}

.account-topbar {
  grid-template-columns: minmax(0, 1fr) minmax(220px, 0.44fr);
  align-items: start;
  overflow: hidden;
}

.account-control {
  grid-template-columns: max-content minmax(120px, 0.72fr) minmax(150px, 1fr) max-content max-content;
}

.account-control select,
.account-control input {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.account-scope {
  max-width: 100%;
}

.account-readiness,
.readiness-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  min-width: 0;
  max-width: 100%;
}

.account-readiness {
  margin-top: 2px;
}

.readiness-chip {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  padding: 3px 7px;
  border: 1px solid #d7e0ec;
  border-radius: 999px;
  background: #f6f9fc;
  color: #52677f;
  font-size: 11px;
  font-weight: 800;
  line-height: 1.25;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.readiness-chip.ok {
  border-color: #b7e1cd;
  background: #eaf8f2;
  color: #176347;
}

.readiness-chip.bad {
  border-color: #f1c4c4;
  background: #fff0f0;
  color: #9f3030;
}

.readiness-chip.muted {
  border-color: #d7e0ec;
  background: #f6f9fc;
  color: #64748b;
}

.account-scope code,
.agent-card code,
.path-row code,
.snapshot-grid code,
.isolation-row code,
.plugin-path-grid code,
.plugin-config-files code,
.memory-hit p,
.question-row strong,
.question-row small,
.question-row em,
.category-card span,
.category-card small,
.category-card p,
.chat-bubble p,
.context-block pre,
.trace-list pre {
  overflow-wrap: anywhere;
  word-break: break-word;
}

.agent-card label,
.agent-card input,
.agent-card select,
.agent-card textarea,
.agent-card .inline-check {
  min-width: 0;
  max-width: 100%;
}

.agent-card input,
.agent-card select,
.agent-card textarea {
  width: 100%;
}

.agent-card label > span {
  overflow-wrap: anywhere;
}

.category-card span {
  width: auto;
  max-width: 100%;
  justify-self: start;
}

.agent-workbench {
  grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
}

.agent-sidebar {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
}

.agent-chat-panel {
  min-height: min(860px, calc(100vh - 180px));
}

.chat-transcript {
  min-height: 420px;
}

.chat-composer .panel-actions,
.eval-action-bar,
.panel-actions {
  flex-wrap: wrap;
}

@media (max-width: 1280px) {
  .account-topbar,
  .agent-workbench {
    grid-template-columns: 1fr;
  }

  .memory-evidence {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .account-control,
  .agent-sidebar,
  .memory-evidence,
  .category-card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .account-control .label,
  .account-control select,
  .account-control input {
    grid-column: 1 / -1;
  }
}

@media (max-width: 640px) {
  .account-control,
  .agent-sidebar,
  .memory-evidence,
  .category-card-grid,
  .snapshot-grid,
  .isolation-grid,
  .plugin-path-grid {
    grid-template-columns: 1fr;
  }

  .account-control .label,
  .account-control select,
  .account-control input,
  .account-control button {
    grid-column: 1 / -1;
    width: 100%;
  }

  .agent-chat-panel {
    min-height: 680px;
  }
}

/* Small-issue cleanup: stable account bar, nav, and workflow cards. */
.account-topbar {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(300px, 1.08fr);
  gap: 12px;
  align-items: stretch;
  overflow: visible;
}

.account-control {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  min-width: 0;
}

.account-picker-row,
.account-create-row {
  display: grid;
  min-width: 0;
  gap: 8px;
  align-items: center;
}

.account-picker-row {
  grid-template-columns: max-content minmax(0, 1fr);
}

.account-create-row {
  grid-template-columns: minmax(0, 1fr) max-content max-content;
}

.account-action-status {
  min-width: 0;
  margin: 0;
  color: #64748b;
  font-size: 12px;
  font-weight: 650;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.account-action-status.ok {
  color: #176347;
}

.account-action-status.warn {
  color: #95630d;
}

.account-action-status.bad {
  color: #9f3030;
}

.account-control select,
.account-control input,
.account-control button {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.account-control button:disabled {
  cursor: not-allowed;
  opacity: 0.52;
}

#deleteAccount:disabled {
  display: none;
}

#deleteAccount:not(:disabled) {
  display: none;
  min-width: 0;
  padding-inline: 10px;
  opacity: 0.68;
}

.account-topbar:hover #deleteAccount:not(:disabled),
#deleteAccount:not(:disabled):focus-visible {
  display: inline-flex;
}

.account-scope {
  display: grid;
  gap: 8px;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
}

.account-scope-head {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 10px;
  align-items: baseline;
  min-width: 0;
}

.account-scope-head strong {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.account-scope-head span {
  flex: 1 1 220px;
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.account-path-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
  min-width: 0;
}

.account-path-grid code {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.workflow-guide {
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  overflow: visible;
}

.workflow-step {
  min-width: 0;
}

.workflow-step strong,
.workflow-step p {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  line-height: 1.35;
}

@media (max-width: 900px) {
  .side-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    overflow: visible;
    padding: 0;
  }

  .nav-group {
    display: contents;
  }

  .nav-group > span {
    grid-column: 1 / -1;
    min-width: 0;
    padding: 8px 2px 0;
    overflow-wrap: anywhere;
  }

  .nav-item {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 34px;
    white-space: normal;
    line-height: 1.25;
  }

  .workflow-guide {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    overflow: visible;
  }

  .workflow-step {
    flex: initial;
    min-width: 0;
    border-right: 0;
  }
}

@media (max-width: 760px) {
  .account-topbar {
    grid-template-columns: 1fr;
    overflow: visible;
  }

  .account-create-row {
    grid-template-columns: minmax(0, 1fr) minmax(92px, auto) minmax(92px, auto);
  }

  .account-path-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .side-nav,
  .workflow-guide {
    grid-template-columns: 1fr;
  }

  .account-picker-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 540px) {
  .account-create-row,
  .account-path-grid {
    grid-template-columns: 1fr;
  }
}

/* Workflow guide: keep progress colors unified; selected step gets the only strong marker. */
.workflow-guide {
  border-color: #d8e2f0;
  background: #ffffff;
}

.workflow-step,
.workflow-step.done,
.workflow-step.active,
.workflow-step.warn,
.workflow-step.pending {
  position: relative;
  padding: 12px 48px 12px 12px;
  border-color: #dbe4f0;
  background: #f8fafc;
  opacity: 1;
  box-shadow: none;
}

.workflow-step:hover,
.workflow-step.done:hover,
.workflow-step.active:hover,
.workflow-step.warn:hover,
.workflow-step.pending:hover {
  border-color: #b9cce8;
  background: #f4f8ff;
}

.workflow-step span,
.workflow-step.done span,
.workflow-step.active span,
.workflow-step.warn span,
.workflow-step.pending span {
  border: 1px solid #d4deec;
  background: #ffffff;
  color: #40516a;
}

.workflow-step strong {
  color: #10233f;
}

.workflow-step p,
.workflow-step.done p,
.workflow-step.active p,
.workflow-step.warn p,
.workflow-step.pending p {
  color: #667790;
}

.workflow-step.done p::before {
  content: "完成 · ";
  color: #40516a;
  font-weight: 800;
}

.workflow-step.warn p::before {
  content: "注意 · ";
  color: #40516a;
  font-weight: 800;
}

.workflow-step.selected {
  border-color: #8fb7f4;
  background: #f3f7ff;
  box-shadow: inset 4px 0 0 #2563eb;
}

.workflow-step.selected span {
  border-color: #2563eb;
  background: #2563eb;
  color: #ffffff;
}

.workflow-step.selected::after {
  content: "当前";
  position: absolute;
  top: 10px;
  right: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  min-height: 20px;
  padding: 2px 7px;
  border: 1px solid #b8cdf2;
  border-radius: 999px;
  background: #ffffff;
  color: #164b9b;
  font-size: 11px;
  font-weight: 850;
  line-height: 1;
}

@media (max-width: 640px) {
  .workflow-step,
  .workflow-step.done,
  .workflow-step.active,
  .workflow-step.warn,
  .workflow-step.pending {
    padding-right: 12px;
  }

  .workflow-step.selected::after {
    position: static;
    justify-self: start;
    margin-top: 6px;
    grid-column: 2;
  }
}

/* Agent chat polish */
#chatView {
  background: #f7f9fc;
}

#chatView > .panel-head {
  align-items: center;
  margin-bottom: 14px;
}

#chatView .agent-workbench {
  grid-template-columns: minmax(220px, 260px) minmax(520px, 1fr) minmax(300px, 380px);
  gap: 14px;
  align-items: stretch;
}

#chatView .agent-sidebar {
  grid-column: auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  align-content: start;
}

#chatView .agent-card {
  border-color: #e1e8f2;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12px 30px rgba(15, 35, 65, 0.05);
}

#chatView .agent-card h3 {
  color: #10233f;
  font-size: 12px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

#chatView .agent-mode-note {
  display: grid;
  gap: 4px;
  margin-top: 10px;
  padding: 10px;
  border: 1px solid #dbeafe;
  border-radius: 8px;
  background: #f5f9ff;
}

#chatView .agent-mode-note strong {
  color: #164b9b;
  font-size: 12px;
}

#chatView .agent-mode-note span {
  color: #52677f;
  font-size: 12px;
  line-height: 1.5;
}

#chatView .agent-chat-panel {
  grid-template-rows: auto minmax(420px, 1fr) auto;
  min-height: min(760px, calc(100vh - 170px));
  border: 1px solid #dce6f2;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 18px 46px rgba(15, 35, 65, 0.08);
}

#chatView .agent-chat-head {
  align-items: center;
  padding: 14px 18px;
  border-bottom: 1px solid #edf2f7;
  background: rgba(255, 255, 255, 0.92);
}

#chatView .agent-chat-head strong {
  color: #10233f;
  font-size: 15px;
}

#chatView .chat-transcript {
  min-height: 420px;
  padding: 24px;
  background:
    linear-gradient(180deg, rgba(246, 249, 253, 0.96), rgba(255, 255, 255, 0.98)),
    radial-gradient(circle at 12% 0%, rgba(37, 99, 235, 0.06), transparent 34%);
}

#chatView .chat-bubble {
  width: fit-content;
  max-width: min(760px, 78%);
  margin-bottom: 16px;
  padding: 12px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 14px 14px 14px 4px;
  background: #ffffff;
  box-shadow: 0 10px 24px rgba(15, 35, 65, 0.06);
}

#chatView .chat-bubble.user {
  margin-left: auto;
  border-color: #2d6cdf;
  border-radius: 14px 14px 4px 14px;
  background: #2563eb;
  color: #ffffff;
}

#chatView .chat-bubble.user strong,
#chatView .chat-bubble.user p {
  color: #ffffff;
}

#chatView .chat-bubble strong {
  margin-bottom: 5px;
  color: #667790;
  font-size: 11px;
  font-weight: 850;
}

#chatView .chat-bubble p {
  color: #10233f;
  font-size: 14px;
  line-height: 1.7;
}

#chatView .chat-composer {
  gap: 10px;
  padding: 14px;
  border-top: 1px solid #edf2f7;
  background: #ffffff;
}

#chatView .chat-composer textarea {
  min-height: 92px;
  max-height: 180px;
  padding: 13px 14px;
  border: 1px solid #d9e3ef;
  border-radius: 12px;
  background: #fbfdff;
  box-shadow: inset 0 1px 2px rgba(15, 35, 65, 0.04);
}

#chatView .chat-composer .panel-actions {
  justify-content: space-between;
}

#chatView .memory-evidence {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  align-content: start;
}

#chatView .memory-list,
#chatView .trace-list {
  max-height: 260px;
  overflow: auto;
}

#chatView .result-kpis.compact {
  grid-template-columns: 1fr;
}

#chatView .agent-workbench.context-collapsed {
  grid-template-columns: minmax(220px, 260px) minmax(0, 1fr);
}

#chatView .agent-workbench.context-collapsed .agent-chat-panel {
  grid-column: auto;
}

@media (max-width: 1280px) {
  #chatView .agent-workbench,
  #chatView .agent-workbench.context-collapsed {
    grid-template-columns: 1fr;
  }

  #chatView .agent-sidebar,
  #chatView .memory-evidence {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  #chatView .agent-sidebar,
  #chatView .memory-evidence {
    grid-template-columns: 1fr;
  }

  #chatView .chat-bubble {
    max-width: 92%;
  }
}

/* Unified product UI pass inspired by blue-professional / soft-editorial */
:root {
  --bg: #f3f6fb;
  --bg-secondary: #eef3f9;
  --panel: #ffffff;
  --ink: #10233f;
  --ink-secondary: #54657d;
  --muted: #6f8199;
  --line: #dbe4ef;
  --line-strong: #c8d4e3;
  --accent: #2563eb;
  --accent-hover: #1d4ed8;
  --accent-light: #e8f0ff;
  --accent-deep: #10233f;
  --shadow-md: 0 12px 30px rgba(15, 35, 65, 0.06);
  --shadow-lg: 0 18px 42px rgba(15, 35, 65, 0.09);
}

body {
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.07), transparent 28%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(243, 246, 251, 0.96)),
    var(--bg);
  color: var(--ink);
}

.app-shell {
  background: transparent;
}

.app-sidebar {
  border-right: 1px solid rgba(200, 212, 227, 0.9);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(14px);
}

.brand-block .label {
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 11px;
  font-weight: 800;
  color: #6b7b90;
}

.brand-block strong {
  font-size: 20px;
  font-weight: 700;
}

.nav-group > span {
  padding: 4px 10px;
  color: #7c8ca3;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.nav-item,
.nav-link {
  height: 42px;
  border-radius: 10px;
  font-weight: 650;
}

.nav-item:hover,
.nav-link:hover {
  background: #f4f7fb;
}

.nav-item.active {
  background: linear-gradient(180deg, #f4f8ff 0%, #edf4ff 100%);
  border-color: #cddcfb;
  box-shadow: inset 3px 0 0 var(--accent), 0 6px 14px rgba(37, 99, 235, 0.08);
}

.nav-more {
  display: grid;
  gap: 6px;
}

.nav-more summary {
  list-style: none;
  cursor: pointer;
  padding: 7px 10px;
  border-radius: 8px;
  color: #8ea0b8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.nav-more summary::-webkit-details-marker {
  display: none;
}

.nav-more summary:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
}

.nav-more .nav-item {
  margin-left: 8px;
}

.app-content {
  padding-bottom: 48px;
}

.account-topbar,
.view-hero,
.panel,
.view-panel,
.agent-card,
.agent-chat-panel,
.report-run-column,
.report-detail-panel,
.report-control-card,
.report-analysis-stack details,
.report-help-panel,
.workflow-step,
.memory-hit,
.analysis-box,
.question-detail,
.task-strip,
.task-list,
.quick-test-status,
.memory-warning,
.check-list,
.judge-estimate,
.pending-judge-panel,
.path-list {
  border-radius: 12px;
}

.account-topbar,
.view-hero,
.panel,
.agent-chat-panel,
.agent-card,
.report-run-column,
.report-detail-panel,
.report-control-card,
.report-analysis-stack details,
.report-help-panel {
  border-color: rgba(219, 228, 239, 0.95);
  box-shadow: var(--shadow-md);
}

.account-topbar {
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(12px);
}

.view-hero {
  border: 1px solid rgba(219, 228, 239, 0.92);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(241, 246, 255, 0.96)),
    #ffffff;
}

.view-hero .label {
  color: #6d7d92;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 11px;
  font-weight: 800;
}

.view-hero h1,
.panel-head h2,
.report-control-card h3,
.report-section-head h3 {
  letter-spacing: 0;
}

.view-hero h1 {
  font-size: 29px;
  font-weight: 700;
  color: #10233f;
}

.view-hero p,
.panel-head p,
.workflow-step p,
.agent-card p,
.report-control-card p,
.quick-test-status p,
.judge-estimate p {
  color: #5e6f86;
}

.panel,
.view-panel {
  border: 1px solid rgba(219, 228, 239, 0.95);
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(10px);
}

.panel-head {
  margin-bottom: 14px;
}

button.primary,
button.primary.alt,
button.secondary,
.button-link.secondary {
  min-height: 38px;
  border-radius: 10px;
  transition: transform var(--transition), box-shadow var(--transition), background var(--transition), border-color var(--transition);
}

button.primary {
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
  box-shadow: 0 10px 22px rgba(37, 99, 235, 0.22);
}

button.primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 14px 28px rgba(37, 99, 235, 0.24);
}

button.primary.alt {
  background: #edf4ff;
  color: #1e4fbf;
  border: 1px solid #cfe0ff;
}

button.secondary,
.button-link.secondary {
  border: 1px solid #d8e2ee;
  background: #ffffff;
  color: #29405f;
}

button.secondary:hover,
.button-link.secondary:hover {
  background: #f6f9fd;
  border-color: #c4d5ea;
}

input,
select,
textarea {
  border-radius: 10px;
  border: 1px solid #d7e0ec;
  background: rgba(255, 255, 255, 0.96);
  color: #10233f;
  box-shadow: inset 0 1px 2px rgba(15, 35, 65, 0.03);
}

input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: #99baf8;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10);
}

label > span,
.panel-head.tight h2,
.agent-card h3,
.memory-browser-grid h3,
.runs-layout h3,
.analysis-grid h3 {
  color: #213754;
}

.workflow-guide {
  gap: 12px;
}

.workflow-step {
  border: 1px solid #dbe4ef;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 8px 20px rgba(15, 35, 65, 0.04);
}

.workflow-step span {
  border-radius: 12px;
}

.stage-card,
.category-card,
.dataset-cards > article,
.memory-hit,
.question-row,
.task-row,
.latest-run-card {
  border-radius: 12px;
  border: 1px solid #dee6f0;
  background: #ffffff;
  box-shadow: 0 8px 20px rgba(15, 35, 65, 0.04);
}

.memory-hit:hover,
.question-row:hover,
.latest-run-card:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 24px rgba(15, 35, 65, 0.07);
}

.path-list,
.analysis-box,
.question-detail,
.task-strip,
.task-list,
.memory-warning,
.judge-estimate,
.pending-judge-panel {
  border: 1px solid #dfe7f1;
  background: rgba(249, 251, 254, 0.9);
}

.report-analysis-stack summary,
.report-help-panel summary,
.evidence-details summary,
.context-details summary,
.archive-log-details summary {
  background: #f7faff;
}

.sidebar-status,
.readiness-chip,
.check,
.status-pill,
.label {
  border-radius: 999px;
}

.result-kpis .kpi,
.report-kv article,
.diff-summary section {
  border-radius: 10px;
  border-color: #dde6f1;
  background: #ffffff;
}

pre.log,
.context-block pre,
.trace-list pre {
  border-radius: 10px;
  border: 1px solid #dde5f0;
  background: #f8fbff;
}

/* Clean SaaS shell v2: reset the accumulated visual noise */
:root {
  --bg: #f6f7fb;
  --panel: #ffffff;
  --ink: #111827;
  --ink-secondary: #4b5563;
  --muted: #6b7280;
  --line: #e5e7eb;
  --line-strong: #d1d5db;
  --accent: #2563eb;
  --accent-hover: #1d4ed8;
  --accent-light: #eff6ff;
  --accent-deep: #172554;
  --shadow-md: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-lg: 0 8px 24px rgba(15, 23, 42, 0.08);
}

body {
  background: #f6f7fb;
  color: var(--ink);
  font: 14px/1.55 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.app-shell {
  grid-template-columns: 248px minmax(0, 1fr);
  background: #f6f7fb;
}

.app-sidebar {
  padding: 18px 12px;
  border-right: 0;
  background: #0f172a;
  color: #e5e7eb;
  box-shadow: none;
}

.brand-block {
  padding: 8px 10px 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

.brand-block .label {
  color: #93a4bd;
  font-size: 11px;
  letter-spacing: 0.08em;
}

.brand-block strong {
  color: #ffffff;
  font-size: 18px;
  font-weight: 750;
}

.nav-group {
  display: grid;
  gap: 4px;
  margin-top: 8px;
}

.nav-group > span {
  margin-top: 10px;
  padding: 0 10px 4px;
  color: #8fa1bb;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.nav-item,
.nav-link {
  height: 38px;
  padding: 0 10px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #cbd5e1;
  font-size: 13px;
  font-weight: 650;
}

.nav-item:hover,
.nav-link:hover {
  background: rgba(255, 255, 255, 0.07);
  color: #ffffff;
}

.nav-item.active {
  border-color: rgba(96, 165, 250, 0.35);
  background: #1d4ed8;
  color: #ffffff;
  box-shadow: none;
}

.sidebar-status {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
}

.app-content {
  display: grid;
  gap: 14px;
  max-width: 1500px;
  width: 100%;
  margin: 0 auto;
  padding: 18px 22px 42px;
}

.account-topbar,
.view-hero,
.workflow-guide,
.view-panel,
.panel {
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #ffffff;
  box-shadow: var(--shadow-md);
  backdrop-filter: none;
}

.account-topbar {
  align-items: center;
  padding: 12px;
}

.account-control,
.account-scope {
  gap: 8px;
}

.account-scope {
  border: 1px solid #eef0f4;
  border-radius: 8px;
  background: #fafbfc;
  padding: 10px;
}

.view-hero {
  padding: 20px 22px;
  background: #ffffff;
}

.view-hero .label {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.view-hero h1 {
  margin: 3px 0 2px;
  color: #111827;
  font-size: 26px;
  font-weight: 760;
}

.view-hero p,
.panel-head p,
.quick-test-status p {
  color: #6b7280;
}

.workflow-guide {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 8px;
}

.workflow-step {
  min-height: 72px;
  border: 0;
  border-right: 1px solid #eef0f4;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.workflow-step:last-child {
  border-right: 0;
}

.workflow-step.selected {
  border-radius: 8px;
  background: #eff6ff;
  box-shadow: inset 0 0 0 1px #bfdbfe;
}

.workflow-step.selected::after {
  top: 8px;
  right: 8px;
  border: 0;
  background: #dbeafe;
}

.view-panel,
.panel {
  padding: 18px;
}

.panel-head {
  padding: 0;
  margin: 0 0 14px;
}

.panel-head h2 {
  color: #111827;
  font-size: 18px;
  font-weight: 740;
}

.panel-head.tight {
  padding-top: 12px;
  border-top: 1px solid #eef0f4;
}

.agent-card,
.report-control-card,
.report-run-column,
.report-detail-panel,
.report-analysis-stack details,
.memory-hit,
.question-row,
.task-row,
.stage-card,
.category-card,
.analysis-box,
.path-list,
.quick-test-status,
.judge-estimate,
.pending-judge-panel,
.check-list,
.task-strip,
.task-list {
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #ffffff;
  box-shadow: none;
}

.stage-card:hover,
.memory-hit:hover,
.question-row:hover {
  border-color: #bfdbfe;
  background: #f8fbff;
  transform: none;
  box-shadow: none;
}

button.primary,
button.primary.alt,
button.secondary,
.button-link.secondary {
  min-height: 36px;
  border-radius: 8px;
  box-shadow: none;
  font-size: 13px;
  font-weight: 700;
}

button.primary {
  border: 1px solid #1d4ed8;
  background: #2563eb;
  color: #ffffff;
}

button.primary:hover {
  transform: none;
  background: #1d4ed8;
  box-shadow: none;
}

button.primary.alt {
  border: 1px solid #bfdbfe;
  background: #eff6ff;
  color: #1d4ed8;
}

button.secondary,
.button-link.secondary {
  border: 1px solid #d1d5db;
  background: #ffffff;
  color: #374151;
}

button.secondary:hover,
.button-link.secondary:hover {
  background: #f9fafb;
  border-color: #9ca3af;
}

button.danger {
  border-radius: 8px;
}

input,
select,
textarea {
  min-height: 38px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: #ffffff;
  color: #111827;
  box-shadow: none;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

label > span {
  color: #374151;
  font-size: 12px;
  font-weight: 750;
}

.progress-bar {
  height: 8px;
  border-radius: 999px;
  background: #eef2f7;
}

.progress-bar span {
  border-radius: 999px;
  background: #2563eb;
}

#chatView {
  background: #ffffff;
}

#chatView .agent-workbench {
  grid-template-columns: 220px minmax(520px, 1fr) 340px;
}

#chatView .agent-card,
#chatView .agent-chat-panel {
  box-shadow: none;
}

#chatView .agent-chat-panel {
  min-height: min(700px, calc(100vh - 190px));
  border-radius: 10px;
}

#chatView .agent-chat-head {
  background: #ffffff;
}

#chatView .chat-transcript {
  background: #f8fafc;
}

#chatView .chat-bubble {
  border-radius: 12px 12px 12px 3px;
  box-shadow: none;
}

#chatView .chat-bubble.user {
  border-radius: 12px 12px 3px 12px;
}

#chatView .chat-composer textarea {
  border-radius: 10px;
  background: #ffffff;
}

.report-control-panel {
  gap: 10px;
}

.report-analysis-stack details,
.report-help-panel {
  overflow: hidden;
}

.report-analysis-stack summary,
.report-help-panel summary {
  background: #fafbfc;
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .app-sidebar {
    position: static;
    height: auto;
  }

  .workflow-guide {
    grid-template-columns: 1fr;
  }

  .workflow-step {
    border-right: 0;
    border-bottom: 1px solid #eef0f4;
  }

  #chatView .agent-workbench {
    grid-template-columns: 1fr;
  }
}

.chat-page-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fafbfc;
}

.chat-page-toolbar span {
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}

body[data-active-view="chatView"] .view-hero,
body[data-active-view="chatView"] .workflow-guide {
  display: none;
}

body[data-active-view="openvikingView"] .view-hero,
body[data-active-view="evalView"] .view-hero,
body[data-active-view="judgeView"] .view-hero,
body[data-active-view="runsView"] .view-hero,
body[data-active-view="memoryView"] .view-hero,
body[data-active-view="datasetView"] .view-hero {
  display: none;
}

#chatView .chat-page-toolbar {
  justify-content: flex-end;
  min-height: 36px;
}

#chatView .agent-chat-head {
  min-height: 24px;
  justify-content: flex-end;
}

/* Minimal account bar + chat tabs */
.account-topbar {
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  padding: 10px 12px;
}

.account-control {
  display: flex;
  align-items: center;
  gap: 8px;
}

.account-picker-row,
.account-create-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.account-picker-row .label {
  min-width: auto;
}

.account-create-row input {
  width: 180px;
}

.account-scope {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding: 0;
  border: 0;
  background: transparent;
}

.account-scope-head {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.account-scope-head strong {
  display: none;
}

.account-scope-head span,
.account-action-status {
  margin: 0;
  color: #6b7280;
  font-size: 12px;
}

.account-scope-head span {
  display: none;
}

.account-action-status:empty {
  display: none;
}

.account-readiness {
  margin: 0;
}

.tab-card {
  padding: 0;
  overflow: hidden;
}

.mini-archive-status {
  margin-top: 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fafbfc;
}

.mini-archive-status summary {
  cursor: pointer;
  padding: 8px 10px;
  color: #4b5563;
  font-size: 12px;
  font-weight: 700;
}

.mini-archive-status .archive-status {
  padding: 0 10px 10px;
}

.tab-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  border-bottom: 1px solid var(--line);
  background: #f9fafb;
}

.tab-button {
  min-height: 38px;
  border: 0;
  border-right: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  color: #6b7280;
  font-size: 12px;
  font-weight: 750;
}

.tab-button:last-child {
  border-right: 0;
}

.tab-button.active {
  background: #ffffff;
  color: #1d4ed8;
  box-shadow: inset 0 -2px 0 #2563eb;
}

.chat-tab-panels {
  min-height: 260px;
}

.chat-tab-panel {
  display: none;
  padding: 12px;
}

.chat-tab-panel.active {
  display: block;
}

#chatView .memory-evidence {
  gap: 0;
}

#chatView .memory-list,
#chatView .trace-list {
  max-height: calc(100vh - 260px);
}

@media (max-width: 980px) {
  .account-topbar,
  .account-control,
  .account-scope {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: stretch;
  }

  .account-create-row input {
    width: 100%;
  }
}

/* Account bar final compact pass */
.account-topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px 14px;
}

.account-control {
  display: flex !important;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.account-picker-row,
.account-create-row {
  min-width: 0;
}

.account-control select {
  width: 112px;
}

.account-create-row input {
  width: 108px;
}

.account-scope {
  display: flex !important;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  min-width: auto;
}

@media (max-width: 720px) {
  .account-topbar {
    align-items: stretch;
  }

  .account-control,
  .account-scope {
    width: 100%;
  }

  .account-scope {
    justify-content: flex-start;
  }
}

/* Interaction surfaces: lighter controls, clearer primary action */
#chatView .agent-sidebar {
  width: 100%;
}

#chatView .agent-card {
  padding: 12px;
}

#chatView .agent-card h3 {
  margin-bottom: 10px;
  color: #6b7280;
  font-size: 11px;
  letter-spacing: 0.08em;
}

#chatView .agent-mode-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 0 0;
  border: 0;
  border-top: 1px solid #eef0f4;
  border-radius: 0;
  background: transparent;
}

#chatView .agent-mode-note strong {
  color: #374151;
}

#chatView .agent-mode-note span {
  color: #6b7280;
  text-align: right;
}

.mini-archive-status {
  background: #ffffff;
}

.log-details {
  margin-top: 12px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fafbfc;
  overflow: hidden;
}

.log-details summary {
  cursor: pointer;
  padding: 10px 12px;
  color: #4b5563;
  font-size: 12px;
  font-weight: 700;
  background: #f9fafb;
}

.log-details[open] summary {
  border-bottom: 1px solid #e5e7eb;
}

.log-details pre.log {
  margin: 0;
  border: 0;
  border-radius: 0;
  background: #fbfdff;
}

/* Final log readability guard: accumulated log styles used a light
   background with inherited light text, making import logs unreadable. */
pre.log,
.log-details pre.log,
#importLogBox,
#evalLogBox,
#judgeLogBox {
  color: #172033;
  background: #f8fbff;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

#importLogBox {
  min-height: 260px;
  border: 1px solid #d8e4f2;
  font-size: 12px;
  line-height: 1.58;
}

.advanced-settings {
  margin: 14px 0 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fff;
}

.advanced-settings summary {
  min-height: 42px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  cursor: pointer;
  color: var(--ink-secondary);
  font-size: 13px;
  font-weight: 700;
}

.advanced-settings[open] {
  padding: 0 14px 14px;
}

.advanced-settings[open] summary {
  margin: 0 -14px 14px;
  border-bottom: 1px solid var(--line);
}

.compact-actions {
  margin-bottom: 12px;
}

#importIntegrityPanel:empty,
#importedMemoryList:empty,
#memoryFilePreview:empty,
#sessionBrowserList:empty,
#memoryTimelineList:empty {
  display: none;
}

.eval-action-bar {
  align-items: center;
  justify-content: flex-start;
  padding: 10px;
  border-color: #e5e7eb;
  background: #f9fafb;
}

#judgeView .eval-action-bar.result-actions {
  justify-content: flex-end;
}

/* Minimal product pass: quieter account bar and chat controls. */
.account-topbar {
  min-height: 52px;
  padding: 8px 12px;
  border-radius: 10px;
  background: #ffffff;
}

.account-picker-row {
  padding: 4px 6px;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  background: #f9fafb;
}

.account-picker-row .label {
  color: #6b7280;
  font-size: 12px;
  font-weight: 750;
}

.account-control select,
.account-control input,
.account-control button {
  min-height: 30px;
  border-radius: 999px;
}

.account-control select {
  width: 128px;
  border: 0;
  background: transparent;
  font-weight: 800;
}

.account-create-row input {
  width: 118px;
  background: #ffffff;
}

.account-create-row button {
  padding-inline: 12px;
}

#deleteAccount:disabled {
  display: none;
}

.account-scope {
  gap: 6px;
}

.readiness-chip {
  min-height: 26px;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 12px;
}

.account-action-status {
  max-width: 220px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#chatView .agent-workbench {
  grid-template-columns: 176px minmax(520px, 1fr) 340px;
  gap: 12px;
}

#chatView .agent-sidebar .agent-card {
  position: sticky;
  top: 86px;
  display: grid;
  gap: 10px;
  padding: 10px;
  border-radius: 10px;
  background: #fbfcfe;
}

.chat-side-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.chat-side-top strong {
  color: #4b5563;
  font-size: 12px;
}

#chatView .inline-control {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 8px;
}

#chatView .inline-control span {
  color: #6b7280;
  font-size: 12px;
  font-weight: 700;
}

#chatView .inline-control input {
  min-height: 32px;
  border-radius: 8px;
}

.chat-side-top .mini-archive-status {
  margin: 0;
  border: 0;
  background: transparent;
}

.chat-side-top .mini-archive-status summary {
  padding: 0;
  color: #2563eb;
}

.chat-side-top .mini-archive-status .archive-status {
  position: absolute;
  z-index: 4;
  width: 180px;
  margin-top: 8px;
  padding: 8px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
}

#activeTaskStrip:empty,
#recentTaskList:empty,
#judgePreflightBox:empty,
#questionPicker:empty,
#runsList:empty,
#runArtifactList:empty,
#evalSampleRows:empty,
#runQuestionList:empty,
#judgeQuestionDetailPane:empty,
#questionDetailPane:empty,
#runDiffResult:empty,
#runCompareResult:empty,
#wrongClusterResult:empty,
#runReportResult:empty,
#longMemBaselineResult:empty,
#configSnapshotResult:empty {
  display: none;
}

#runsView .report-control-card p {
  display: none;
}

#runsView .report-help-panel .flow-compare-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

#runsView .report-help-panel summary {
  font-size: 12px;
}

#runsView .run-compare-toggle span {
  font-size: 11px;
}

.judge-question-layout {
  margin-top: 10px;
}

#judgeView #evalSampleRows {
  max-height: 760px;
  overflow: auto;
  padding-right: 2px;
}

.question-picker-card {
  cursor: pointer;
  display: grid;
  gap: 8px;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, transform 0.18s ease;
}

.question-picker-card header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.question-picker-card.correct {
  border-left: 4px solid #16a34a;
}

.question-picker-card.wrong {
  border-left: 4px solid #dc2626;
}

.question-picker-card.pending {
  border-left: 4px solid #f59e0b;
}

.question-picker-card.active {
  border-color: #93c5fd;
  background: #eef4ff;
  box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.14);
}

#runsView .report-action-row,
#runsView .report-action-stack {
  gap: 8px;
}

/* One-line space switcher. */
.account-topbar {
  display: grid;
  grid-template-columns: minmax(210px, auto) auto minmax(230px, auto);
  align-items: center;
  justify-content: stretch;
  gap: 8px;
}

.account-control {
  display: block !important;
}

.account-picker-row {
  display: grid;
  grid-template-columns: auto minmax(110px, 1fr);
  align-items: center;
  gap: 6px;
  max-width: 260px;
}

.account-picker-row .label {
  white-space: nowrap;
}

.account-scope {
  justify-content: center;
}

.account-create-row {
  justify-content: flex-end;
}

.account-create-row input {
  width: 132px;
}

.account-action-status {
  display: none;
}

.account-action-status.warn,
.account-action-status.bad {
  display: block;
}

#chatView .agent-workbench {
  grid-template-columns: 148px minmax(520px, 1fr) 340px;
}

#chatView .agent-sidebar .agent-card {
  gap: 8px;
  padding: 9px;
  border-style: dashed;
  background: #ffffff;
}

#chatView .side-label {
  color: #6b7280;
  font-size: 12px;
  font-weight: 800;
}

@media (max-width: 980px) {
  .account-topbar {
    grid-template-columns: 1fr;
  }

  .account-picker-row {
    max-width: none;
  }

  .account-scope {
    justify-content: flex-start;
  }

  .account-create-row {
    justify-content: flex-start;
  }
}

@media (min-width: 560px) {
  .account-topbar .account-control,
  .account-topbar .account-scope {
    width: auto;
  }

  .account-topbar .account-scope {
    justify-content: flex-end;
  }
}

/* QA question list: denser, easier to scan */
.question-picker {
  gap: 6px;
}

.question-row {
  align-items: start;
  gap: 9px;
  padding: 8px 10px;
  border-color: #eef0f4;
  border-radius: 8px;
  background: #ffffff;
}

.question-row input {
  width: 16px;
  height: 16px;
  margin-top: 2px;
}

.question-row strong {
  color: #111827;
  font-size: 13px;
  font-weight: 680;
  line-height: 1.38;
}

.question-row small {
  margin-top: 3px;
  color: #6b7280;
  font-size: 11px;
}

.question-row em {
  margin-top: 3px;
  color: #64748b;
  font-size: 12px;
  font-style: normal;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.question-row:has(input:checked) {
  border-color: #93c5fd;
  background: #eff6ff;
}

/* Final simplification pass: make the main workflow feel like a product UI. */
.account-topbar {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) auto minmax(170px, auto);
  min-height: 46px;
  padding: 7px 10px;
  border-radius: 8px;
  box-shadow: none;
}

.account-topbar .account-picker-row {
  max-width: 240px;
  padding: 2px 6px;
}

.account-topbar .account-picker-row .label {
  font-size: 11px;
}

.account-topbar .account-control select {
  width: 118px;
  height: 28px;
  min-height: 28px;
  padding: 0 4px;
}

.account-topbar .account-create-row {
  gap: 6px;
}

.account-topbar .account-create-row input {
  width: 112px;
  height: 30px;
  min-height: 30px;
}

.account-topbar .account-create-row button {
  min-height: 30px;
  min-width: 0;
  padding-inline: 10px;
}

.account-topbar .readiness-chip {
  min-height: 24px;
  padding: 4px 9px;
}

#chatView .agent-workbench {
  grid-template-columns: minmax(560px, 1fr) 340px;
  gap: 10px;
}

#chatView .agent-sidebar .agent-card {
  padding: 8px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #ffffff;
}

#chatView .side-label {
  font-size: 11px;
}

#chatView .inline-control {
  grid-template-columns: 1fr;
  gap: 4px;
}

#chatView .inline-control input {
  height: 30px;
  min-height: 30px;
  padding-inline: 8px;
}

#runsView .report-action-row,
#runsView .report-action-stack,
#evalView .eval-action-bar,
#judgeView .eval-action-bar {
  gap: 6px;
}

#runsView .report-action-row button,
#runsView .report-action-stack button,
#evalView .eval-action-bar button,
#judgeView .eval-action-bar button {
  min-height: 34px;
  padding-inline: 12px;
}

@media (max-width: 980px) {
  .account-topbar,
  #chatView .agent-workbench {
    grid-template-columns: 1fr;
  }

  #chatView .agent-sidebar .agent-card {
    position: static;
  }
}

/* Final chat simplification: one conversation column plus one evidence column. */
#chatView .chat-page-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px 12px;
  min-height: 42px;
  margin-bottom: 10px;
  padding: 8px 10px;
  border-radius: 8px;
  background: #ffffff;
}

#chatView .chat-toolbar-left {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

#chatView .inline-control.compact {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0;
}

#chatView .inline-control.compact span {
  color: #6b7280;
  font-size: 12px;
  font-weight: 750;
  white-space: nowrap;
}

#chatView .inline-control.compact input {
  width: 58px;
  height: 30px;
  min-height: 30px;
  padding-inline: 8px;
  border-radius: 8px;
}

#chatView .chat-page-toolbar .panel-actions {
  margin: 0;
  gap: 6px;
}

#chatView .chat-page-toolbar button {
  min-height: 30px;
  padding-inline: 10px;
}

#chatView .chat-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  min-width: 0;
}

#chatView .agent-workbench {
  grid-template-columns: minmax(560px, 1fr) minmax(300px, 340px);
  gap: 10px;
}

#chatView .agent-workbench.context-collapsed {
  grid-template-columns: minmax(0, 1fr);
}

#chatView .agent-workbench.context-collapsed .memory-evidence {
  display: none;
}

#chatView .agent-chat-head {
  justify-content: flex-start;
  min-height: 40px;
  padding: 10px 14px;
}

#chatView .chat-head-title {
  color: #374151;
  font-size: 13px;
  font-weight: 800;
}

#chatView .chat-composer .panel-actions {
  justify-content: flex-end;
}

#chatView .memory-evidence {
  min-width: 0;
}

@media (max-width: 980px) {
  #chatView .agent-workbench,
  #chatView .agent-workbench.context-collapsed {
    grid-template-columns: 1fr;
  }
}

/* Final nav/readme polish: compact, calm, and consistent with the main flow. */
.app-sidebar {
  width: 218px;
}

.brand-block {
  padding-bottom: 12px;
}

.brand-block .label {
  font-size: 11px;
}

.brand-block strong {
  font-size: 15px;
}

.nav-group {
  gap: 4px;
}

.nav-group > span,
.nav-more summary {
  font-size: 11px;
}

.nav-item {
  min-height: 34px;
  padding: 0 10px;
  border-radius: 7px;
  font-size: 13px;
}

.sidebar-status {
  min-height: 30px;
  padding: 7px 9px;
  border-radius: 7px;
  font-size: 12px;
}

.benchmark-workbench .panel-head,
#readmeView .panel-head {
  margin-bottom: 16px;
}

.benchmark-workbench .panel-head p,
#readmeView .panel-head p,
.readme-section .section-title-row p {
  max-width: 720px;
  color: #64748b;
  font-size: 13px;
}

.readme-grid,
.readme-two-col,
.readme-flow,
.analysis-grid {
  gap: 12px;
}

.readme-card,
.readme-flow article,
.benchmark-workbench .analysis-box,
.quick-test-status {
  border-radius: 8px;
}

.readme-card {
  padding: 14px;
}

.readme-card.primary {
  border-left: 3px solid #2563eb;
}

.readme-card span {
  font-size: 12px;
}

.readme-card li,
.readme-card p {
  font-size: 13px;
  line-height: 1.5;
}

.benchmark-workbench .panel-actions button,
.benchmark-workbench .path-input-action button {
  min-height: 34px;
  padding-inline: 12px;
}

/* Final report/config simplification pass. */
#runsView .panel-head {
  margin-bottom: 10px;
}

#runsView .report-help-panel {
  margin-bottom: 10px;
  border-style: dashed;
  background: #ffffff;
}

#runsView .report-help-panel summary {
  min-height: 34px;
  padding: 8px 10px;
  color: #64748b;
  font-size: 12px;
}

#runsView .report-help-panel .flow-compare-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  padding: 0 10px 10px;
}

#runsView .flow-compare-grid.compact article {
  min-height: 0;
  padding: 8px;
  border-radius: 7px;
}

#runsView .flow-compare-grid.compact p {
  font-size: 12px;
  line-height: 1.4;
}

#runsView .report-workbench {
  grid-template-columns: 1fr;
  gap: 14px;
  margin-top: 10px;
}

#runsView .report-run-column,
#runsView .report-control-card,
#runsView .report-detail-panel,
#runsView .report-analysis-stack details {
  border-color: #e5e7eb;
  border-radius: 8px;
  background: #ffffff;
}

#runsView .report-run-column {
  position: static;
  display: grid;
  max-height: none;
  padding: 10px;
}

#runsView .report-run-column .run-list {
  display: grid;
  grid-auto-flow: row;
  grid-template-columns: minmax(0, 1fr);
  align-items: stretch;
  max-height: 680px;
  overflow-x: hidden;
  overflow-y: auto;
  padding: 2px 4px 4px 2px;
}

#runsView .run-card {
  display: flex;
  min-width: 0;
  height: 100%;
  flex-direction: column;
  overflow: visible;
}

#runsView .run-group-heading {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 10px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
  color: #334155;
}

#runsView .run-group-heading strong {
  color: #0f172a;
  font-size: 13px;
}

#runsView .run-group-heading span {
  color: #64748b;
  font-size: 12px;
  font-weight: 800;
}

#runsView .run-card-actions {
  margin-top: auto;
  padding-top: 8px;
}

#runsView .run-card-actions .primary {
  width: 100%;
}

#runsView .run-time {
  color: #dc2626;
  font-weight: 900;
}

#runsView .run-time b {
  color: #b91c1c;
}

#runsView .report-control-panel {
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.5fr);
  gap: 10px;
}

#runsView .scope-toggle select {
  min-width: 148px;
}

.judge-config-redirect {
  display: block;
  margin: 10px 0;
  padding: 8px 10px;
  border: 1px solid #dbeafe;
  border-radius: 8px;
  background: #f8fbff;
  color: #475569;
  font-size: 12px;
  line-height: 1.45;
}

.judge-config-redirect strong { color: #0f172a; }

#runsView .report-control-card {
  gap: 10px;
  padding: 12px;
}

#runsView .report-control-card.primary-card {
  background: #ffffff;
}

#runsView .report-section-head h3,
#runsView .report-control-card h3 {
  font-size: 14px;
}

#runsView .report-action-row,
#runsView .report-action-stack {
  gap: 6px;
}

#runsView .report-action-row button,
#runsView .report-action-stack button {
  min-height: 32px;
  padding-inline: 10px;
  font-size: 12px;
}

#runsView .report-detail-panel {
  padding: 12px;
}

#runsView .report-analysis-stack {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

#runsView .report-analysis-stack details:first-child {
  grid-column: 1 / -1;
}

#runsView .report-analysis-stack summary {
  min-height: 34px;
  padding: 8px 10px;
  font-size: 12px;
}

#systemConfigView .panel-head {
  margin-bottom: 10px;
}

#systemConfigView .support-link-grid {
  gap: 8px;
  margin: 10px 0 12px;
}

#systemConfigView .support-link-card {
  min-height: 64px;
  padding: 10px 12px;
}

#systemConfigView .support-link-card span {
  font-size: 10px;
}

#systemConfigView .support-link-card strong {
  font-size: 13px;
}

#systemConfigView .readme-section {
  margin-top: 12px;
}

#systemConfigView .handoff-dashboard-section,
#systemConfigView .delivery-boundary-section,
#systemConfigView .agent-alignment-section,
#systemConfigView .account-isolation-section,
#systemConfigView .readiness-section,
#systemConfigView .acceptance-matrix-section,
#systemConfigView .smoke-plan-section,
#systemConfigView .handoff-package-section,
#systemConfigView .setup-pack-section,
#systemConfigView .adapter-doctor-section,
#systemConfigView .echomem-contract-section,
#systemConfigView .system-preflight-section,
#systemConfigView .handoff-audit-section,
#systemConfigView .config-plugin-grid,
#systemConfigView .support-link-grid,
#systemConfigView .system-extra-section {
  display: none !important;
}

#systemConfigView .system-model-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

#systemConfigView .system-model-card {
  display: grid;
  gap: 10px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dbe5f2;
  border-radius: 8px;
  background: #ffffff;
}

#systemConfigView .system-model-card .memory-panel-head {
  padding: 0 0 8px;
  border-bottom: 1px solid #e5edf5;
}

#systemConfigView .system-model-card label {
  display: grid;
  gap: 5px;
}

#systemConfigView .system-model-card label span {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
}

#systemConfigView .model-preflight-row {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  padding-top: 2px;
}

#systemConfigView .model-preflight-row small {
  min-width: 0;
  overflow: hidden;
  color: #64748b;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

#systemConfigView .model-preflight-row small.ok {
  color: #15803d;
}

#systemConfigView .model-preflight-row small.warn {
  color: #b45309;
}

#systemConfigView .model-preflight-row small.bad {
  color: #b91c1c;
}

#systemConfigView .report-kv span {
  text-transform: none;
}

@media (max-width: 980px) {
  #systemConfigView .system-model-grid {
    grid-template-columns: 1fr;
  }
}

#systemConfigView {
  background: #f5f5f7;
}

#systemConfigView .panel-head {
  margin-bottom: 16px;
}

#systemConfigView .panel-head .label {
  color: #6e6e73;
}

#systemConfigView .panel-head h2 {
  color: #1d1d1f;
  font-size: 28px;
  line-height: 1.1;
}

#systemConfigView .panel-head p {
  max-width: 640px;
  margin: 8px 0 0;
  color: #6e6e73;
  font-size: 14px;
  line-height: 1.6;
}

#systemConfigView .backend-control-section,
#systemConfigView .system-model-secondary-section {
  display: grid;
  gap: 14px;
}

#systemConfigView .system-config-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

#systemConfigView .system-config-hero-copy {
  min-width: 0;
}

#systemConfigView .system-config-hero-copy .eyebrow,
#systemConfigView .system-config-panel-head span {
  display: block;
  color: #6e6e73;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

#systemConfigView .system-config-hero-copy h3 {
  margin: 6px 0 0;
  color: #1d1d1f;
  font-size: 24px;
  line-height: 1.15;
}

#systemConfigView .system-config-hero-copy p {
  max-width: 560px;
  margin: 8px 0 0;
  color: #6e6e73;
  font-size: 14px;
  line-height: 1.6;
}

#systemConfigView .system-config-hero-meta {
  min-width: 220px;
  padding: 16px 18px;
  border: 1px solid #e5e5ea;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(18px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
}

#systemConfigView .system-config-hero-meta strong {
  display: block;
  color: #1d1d1f;
  font-size: 22px;
  line-height: 1.1;
}

#systemConfigView .system-config-hero-meta span {
  display: block;
  margin-top: 6px;
  color: #6e6e73;
  font-size: 13px;
  line-height: 1.5;
}

#systemConfigView .backend-segmented {
  display: inline-grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px;
  width: min(420px, 100%);
  padding: 4px;
  border: 1px solid #e5e5ea;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

#systemConfigView .backend-segment {
  min-height: 40px;
  padding: 0 16px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: #6e6e73;
  font-size: 13px;
  font-weight: 700;
}

#systemConfigView .backend-segment.active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
}

#systemConfigView .system-config-shell {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.9fr);
  gap: 16px;
}

#systemConfigView .system-config-main,
#systemConfigView .system-config-side {
  display: grid;
  gap: 16px;
}

#systemConfigView .system-config-panel {
  display: grid;
  gap: 14px;
  min-width: 0;
  padding: 18px;
  border: 1px solid #e5e5ea;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(18px);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
}

#systemConfigView .system-config-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

#systemConfigView .system-config-panel-head strong {
  display: block;
  margin-top: 3px;
  color: #1d1d1f;
  font-size: 17px;
  line-height: 1.25;
}

#systemConfigView .system-config-panel .compact-button {
  min-height: 34px;
  padding: 0 12px;
  border-radius: 999px;
}

#systemConfigView .backend-connection-config {
  gap: 12px;
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

#systemConfigView .backend-connection-config label {
  display: grid;
  gap: 6px;
}

#systemConfigView .backend-connection-config label span,
#systemConfigView .system-model-card label span {
  color: #6e6e73;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

#systemConfigView .backend-connection-config input,
#systemConfigView .system-model-card input {
  min-height: 44px;
  border: 1px solid #e5e5ea;
  border-radius: 14px;
  background: #f5f5f7;
  color: #1d1d1f;
}

#systemConfigView .backend-connection-config input:focus,
#systemConfigView .system-model-card input:focus {
  border-color: #0071e3;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
}

#systemConfigView .system-model-grid.single {
  grid-template-columns: 1fr;
}

#systemConfigView .system-model-grid.secondary {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

#systemConfigView .system-model-card {
  gap: 12px;
  padding: 16px;
  border: 1px solid #e5e5ea;
  border-radius: 18px;
  background: #fafafc;
}

#systemConfigView .system-model-card.primary {
  background: linear-gradient(180deg, #ffffff 0%, #fafafc 100%);
}

#systemConfigView .system-model-card .memory-panel-head {
  padding: 0 0 10px;
  border-bottom: 1px solid #ececf1;
}

#systemConfigView .system-model-card .memory-panel-head strong {
  color: #1d1d1f;
  font-size: 18px;
}

#systemConfigView .system-model-card .memory-panel-head span {
  display: block;
  margin-top: 4px;
  color: #6e6e73;
  font-size: 13px;
  line-height: 1.45;
}

#systemConfigView .model-preflight-row {
  padding-top: 4px;
}

#systemConfigView .model-preflight-row small {
  color: #6e6e73;
  font-weight: 600;
}

#systemConfigView .system-summary-kv {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

#systemConfigView .system-summary-kv article {
  padding: 12px 14px;
  border: 1px solid #ececf1;
  border-radius: 16px;
  background: #fafafc;
}

#systemConfigView .system-summary-kv span {
  color: #6e6e73;
  font-size: 11px;
  font-weight: 700;
}

#systemConfigView .system-summary-kv strong {
  margin-top: 5px;
  color: #1d1d1f;
  font-size: 13px;
  line-height: 1.55;
}

#systemConfigView .backend-config-matrix.agent-only {
  grid-template-columns: 1fr;
}

#systemConfigView .backend-config-card {
  padding: 16px;
  border-radius: 18px;
  border: 1px solid #ececf1;
  background: #fafafc;
}

#systemConfigView .backend-config-card.active {
  border-color: #cfe1f8;
  background: #f8fbff;
}

#systemConfigView .backend-config-head strong {
  color: #1d1d1f;
}

#systemConfigView .backend-config-tag {
  background: #f1f2f4;
  color: #4b5563;
}

#systemConfigView .backend-config-card.active .backend-config-tag {
  background: #e8f1fb;
  color: #0a67c9;
}

#systemConfigView .backend-config-list div {
  grid-template-columns: 78px minmax(0, 1fr);
}

#systemConfigView .backend-config-note {
  color: #6e6e73;
}

#systemConfigView .system-source-panel .handoff-audit-card {
  padding: 14px;
  border: 1px solid #ececf1;
  border-radius: 16px;
  background: #fafafc;
}

#systemConfigView .system-source-panel .handoff-audit-card p {
  margin-top: 6px;
  color: #6e6e73;
}

@media (max-width: 980px) {
  #systemConfigView .system-config-hero,
  #systemConfigView .system-config-panel-head {
    align-items: flex-start;
    flex-direction: column;
  }

  #systemConfigView .system-config-shell,
  #systemConfigView .system-model-grid.secondary,
  #systemConfigView .system-summary-kv {
    grid-template-columns: 1fr;
  }

  #systemConfigView .system-config-hero-meta,
  #systemConfigView .backend-segmented {
    width: 100%;
  }
}

#readmeView .panel-head {
  margin-bottom: 12px;
}

#readmeView ::selection {
  background: #dbeafe;
  color: #111827;
}

#readmeView .readme-doc {
  max-width: 880px;
}

#readmeView .readme-doc-lead {
  margin: 0 0 12px;
  color: #111827;
  font-size: 14px;
  line-height: 1.7;
}

#readmeView .readme-doc-section {
  margin-top: 18px;
}

#readmeView .readme-doc-section h3 {
  margin: 0 0 8px;
  color: #111827;
  font-size: 16px;
  line-height: 1.4;
}

#readmeView .readme-doc p,
#readmeView .readme-doc li {
  color: #374151;
  font-size: 14px;
  line-height: 1.7;
}

#readmeView .readme-doc p {
  margin: 8px 0 0;
}

#readmeView .readme-doc ul,
#readmeView .readme-doc ol {
  margin: 8px 0 0;
  padding-left: 20px;
}

#readmeView .readme-doc li + li {
  margin-top: 4px;
}

#readmeView .readme-doc code {
  word-break: break-word;
}

#readmeView .readme-shell {
  margin: 12px 0 0;
  padding: 12px 14px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  background: #ffffff;
  overflow-x: auto;
}

#readmeView .readme-shell code {
  display: block;
  color: #111827;
  font-size: 12px;
  line-height: 1.6;
  white-space: pre-wrap;
}

@media (max-width: 1180px) {
  #runsView .report-workbench,
  #runsView .report-control-panel,
  #runsView .report-analysis-stack {
    grid-template-columns: 1fr;
  }

  #runsView .report-run-column {
    position: static;
    max-height: none;
  }
}

@media (max-width: 900px) {
  #readmeView .readme-doc {
    max-width: 100%;
  }
}

/* Benchmark pages: shorter headings and calmer quickstart feel. */
.benchmark-workbench .panel-head .label {
  font-size: 10px;
}

.benchmark-workbench .panel-head h2 {
  margin: 2px 0 4px;
  font-size: 20px;
}

.benchmark-workbench .panel-head p {
  max-width: 560px;
  font-size: 13px;
  line-height: 1.45;
}

.benchmark-workbench .quick-test-status {
  margin: 8px 0 0;
  padding: 9px 10px;
  border: 1px dashed #e5e7eb;
  background: #ffffff;
}

.benchmark-workbench .quick-test-status p {
  font-size: 12px;
}

.benchmark-workbench .analysis-grid {
  gap: 10px;
}

.benchmark-workbench .analysis-grid h3 {
  font-size: 13px;
}

.benchmark-workbench .analysis-box p {
  font-size: 12px;
  line-height: 1.45;
}

.benchmark-workbench .panel-actions {
  gap: 6px;
}

.benchmark-workbench .panel-actions button,
.benchmark-workbench .path-input-action button {
  min-height: 32px;
  padding-inline: 10px;
  font-size: 12px;
}

/* Final pass on the four core flows. */
.account-topbar {
  grid-template-columns: minmax(210px, 1fr) auto minmax(190px, auto);
  min-height: 42px;
  padding: 6px 8px;
}

.account-topbar .account-picker-row {
  max-width: 228px;
}

.account-topbar .account-picker-row .label {
  font-size: 10px;
}

.account-topbar .account-control select {
  width: 108px;
  font-size: 13px;
}

.account-topbar .account-create-row {
  gap: 5px;
}

.account-topbar .account-create-row input {
  width: 104px;
}

.account-topbar .account-create-row button {
  padding-inline: 9px;
}

.account-topbar .account-scope {
  gap: 4px;
}

.account-manage {
  position: relative;
  justify-self: end;
}

.account-manage summary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 28px;
  padding: 0 10px;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  background: #ffffff;
  color: #4b5563;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  list-style: none;
}

.account-manage summary::-webkit-details-marker {
  display: none;
}

.account-manage[open] summary {
  border-color: #cbd5e1;
}

.account-manage:not([open]) .account-create-row {
  display: none;
}

.account-manage .account-create-row {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background: #ffffff;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
}

.account-manage .account-create-row input {
  width: 112px;
}

.account-manage .account-create-row button {
  min-height: 30px;
  padding-inline: 9px;
}

.account-topbar .readiness-chip {
  min-height: 22px;
  padding: 4px 8px;
  font-size: 11px;
}

#evalView .panel-head,
#judgeView .panel-head {
  margin-bottom: 10px;
}

#evalView .panel-head h2,
#judgeView .panel-head h2 {
  font-size: 17px;
}

#evalView .panel-head.tight h2 {
  font-size: 14px;
}

#evalView .form-grid,
#judgeView .form-grid {
  gap: 10px;
}

#evalView .eval-action-bar,
#judgeView .eval-action-bar {
  gap: 6px;
  padding: 8px 10px;
}

#evalView .eval-action-bar button,
#judgeView .eval-action-bar button {
  min-height: 32px;
  padding-inline: 10px;
  font-size: 12px;
}

#evalView .quick-test-status,
#judgeView .judge-estimate,
#judgeView .preflight-box {
  margin-top: 8px;
}

#evalView .task-list.compact,
#judgeView .pending-judge-panel {
  margin-top: 8px;
}

#evalView small#evalProgressText,
#judgeView small#judgeProgressText {
  color: #6b7280;
  font-size: 12px;
}

#evalView .legacy-eval-progress {
  display: none;
}

@media (max-width: 980px) {
  .account-manage {
    justify-self: start;
  }

  .account-manage .account-create-row {
    left: 0;
    right: auto;
  }
}

/* Keep the product shell usable in the in-app browser's medium-width panel. */
@media (min-width: 641px) and (max-width: 980px) {
  .app-shell {
    grid-template-columns: 218px minmax(0, 1fr);
  }

  .app-sidebar {
    position: sticky;
    top: 0;
    min-height: 100vh;
    height: 100vh;
  }

  .app-content {
    padding-top: 18px;
  }
}

/* Product visual polish: a calmer, crisper evaluation workbench. */
:root {
  --bg: #f6f7fb;
  --panel: #ffffff;
  --ink: #111827;
  --ink-secondary: #42526b;
  --muted: #6b7280;
  --line: #e6eaf1;
  --line-strong: #cfd8e6;
  --accent: #2563eb;
  --accent-hover: #1d4ed8;
  --accent-light: #eef4ff;
  --accent-deep: #172033;
  --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05), 0 10px 24px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 14px 34px rgba(15, 23, 42, 0.08);
  --focus-ring: 0 0 0 3px rgba(37, 99, 235, 0.14);
}

body {
  background:
    linear-gradient(180deg, rgba(37, 99, 235, 0.055), rgba(246, 247, 251, 0) 280px),
    radial-gradient(circle at 92% 8%, rgba(16, 185, 129, 0.08), transparent 260px),
    var(--bg);
  color: var(--ink);
}

.app-sidebar {
  border-right-color: #dfe5ee;
  background: linear-gradient(180deg, #121a2b 0%, #182236 100%);
  color: #e5eaf3;
}

.brand-block {
  border-bottom-color: rgba(255, 255, 255, 0.12);
}

.brand-block .label,
.nav-group > span,
.nav-more summary {
  color: #9aa7bc;
}

.brand-block strong {
  color: #ffffff;
}

.nav-item {
  color: #d7deea;
  transition: background var(--transition), color var(--transition), box-shadow var(--transition);
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
}

.nav-item.active {
  background: #ffffff;
  color: #172033;
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.16);
}

.sidebar-status {
  border-color: rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #dce4f1;
}

.app-content {
  max-width: 1500px;
}

.account-topbar,
.view-hero,
.panel,
.workflow-guide,
.report-run-column,
.report-control-card,
.report-detail-panel,
.report-analysis-stack details,
.agent-chat-panel,
.agent-card,
.support-link-card,
.readme-card,
.quick-test-status {
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-sm);
}

.account-topbar {
  backdrop-filter: blur(10px);
}

.view-hero {
  background:
    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
}

.view-hero .label,
.panel-head .label,
.section-title-row .label {
  color: #2563eb;
}

.workflow-step {
  transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
}

.workflow-step:hover {
  background: #f8fbff;
}

.workflow-step.selected {
  background: #eef4ff;
}

button.primary,
button.primary.alt {
  border-color: #1d4ed8;
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 8px 16px rgba(37, 99, 235, 0.18);
}

button.primary:hover,
button.primary.alt:hover {
  background: #1d4ed8;
  box-shadow: 0 10px 22px rgba(37, 99, 235, 0.22);
}

button.secondary,
.button-link.secondary {
  border-color: #d8e0eb;
  background: #ffffff;
  color: #334155;
}

button.secondary:hover,
.button-link.secondary:hover {
  border-color: #bdc9d9;
  background: #f8fafc;
}

button.danger {
  border-color: #fecaca;
  background: #fff7f7;
  color: #b91c1c;
}

button.danger:hover {
  border-color: #fca5a5;
  background: #fee2e2;
}

button:focus-visible,
a:focus-visible,
summary:focus-visible,
input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: var(--focus-ring);
}

input,
select,
textarea {
  border-color: #d8e0eb;
  background: #ffffff;
}

input:hover,
select:hover,
textarea:hover {
  border-color: #c4cedd;
}

.readiness-chip.ok,
.check.ok {
  border-color: #bbf7d0;
  background: #ecfdf3;
  color: #166534;
}

.readiness-chip.bad,
.check.bad {
  border-color: #fecaca;
  background: #fff1f2;
  color: #b91c1c;
}

.check.warn {
  border-color: #fed7aa;
  background: #fff7ed;
  color: #9a3412;
}

#chatView .agent-chat-panel {
  border-color: #dfe7f2;
  box-shadow: 0 18px 42px rgba(15, 23, 42, 0.09);
}

#chatView .chat-transcript {
  background:
    linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
}

#chatView .chat-bubble {
  border-color: #e1e8f2;
  background: #ffffff;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
}

#chatView .chat-bubble.user {
  border-color: #1d4ed8;
  background: #2563eb;
}

.tab-strip {
  background: #f7f9fc;
}

.tab-button {
  color: #64748b;
}

.tab-button.active {
  color: #1d4ed8;
  background: #ffffff;
  box-shadow: inset 0 -2px 0 #2563eb;
}

.question-row,
.memory-hit,
.run-card,
.pending-row,
.evidence-card {
  border-color: #e6eaf1;
  background: #ffffff;
  transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
}

.question-row:hover,
.memory-hit:hover,
.run-card:hover,
.pending-row:hover,
.evidence-card:hover {
  border-color: #c9d7eb;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
}

.question-row:has(input:checked) {
  border-color: #93c5fd;
  background: #eff6ff;
}

.account-manage summary {
  border-color: #d8e0eb;
  background: #ffffff;
}

.account-manage .account-create-row {
  border-color: #d8e0eb;
  box-shadow: 0 16px 34px rgba(15, 23, 42, 0.14);
}

/* Account-scoped task visibility and run-state notes. */
.account-run-note {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  min-width: 0;
}

.account-run-note span,
.scope-toggle {
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: rgba(248, 250, 252, 0.86);
  color: #475569;
  border-radius: 999px;
  font-size: 12px;
  line-height: 1;
  white-space: nowrap;
}

.account-run-note span {
  padding: 7px 10px;
}

.scope-toggle {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 32px;
  padding: 7px 10px;
  cursor: pointer;
  user-select: none;
}

.scope-toggle input {
  width: 14px;
  height: 14px;
  margin: 0;
  accent-color: #2563eb;
}

.scope-toggle span {
  font-weight: 650;
}

.global-task-chip {
  position: fixed;
  right: 16px;
  bottom: 16px;
  z-index: 70;
  display: grid;
  flex: none;
  flex-direction: column;
  gap: 5px;
  width: min(300px, calc(100vw - 24px));
  min-height: 0;
  max-width: none;
  padding: 10px 12px;
  border: 1px solid rgba(37, 99, 235, 0.22);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.96);
  color: #0f172a;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.28;
  white-space: normal;
  overflow: hidden;
  text-overflow: clip;
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(12px);
  text-decoration: none;
  cursor: pointer;
}

.global-task-chip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.global-task-badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 7px;
  border-radius: 999px;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 10px;
  font-weight: 800;
}

.global-task-progress {
  color: #1d4ed8;
  font-size: 15px;
  font-weight: 850;
  line-height: 1;
}

.global-task-main,
.global-task-detail,
.global-task-meta {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.global-task-main {
  color: #0f172a;
  font-size: 13px;
  font-weight: 850;
}

.global-task-detail {
  color: #475569;
  font-size: 11px;
  font-weight: 700;
}

.global-task-meta {
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
}

.global-task-chip:hover {
  border-color: rgba(37, 99, 235, 0.36);
  background: #ffffff;
  transform: translateY(-1px);
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.18);
}

.global-task-chip[hidden] {
  display: none;
}

.muted-list-note {
  margin: 0;
  padding: 14px;
  border: 1px dashed rgba(148, 163, 184, 0.5);
  border-radius: 8px;
  background: rgba(248, 250, 252, 0.72);
  color: #64748b;
}

@media (max-width: 760px) {
  .account-run-note {
    width: 100%;
  }

.account-run-note span,
.scope-toggle,
.global-task-chip {
    white-space: normal;
  }

  .global-task-chip {
    right: 10px;
    bottom: 10px;
    width: min(280px, calc(100vw - 20px));
  }
}

/* Final QA progress emphasis. */
#activeTaskStrip.task-strip {
  gap: 12px;
  margin: 14px 0;
  padding: 16px 18px;
  border: 1px solid #cfe0fb;
  border-radius: 12px;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  box-shadow: 0 16px 36px rgba(37, 99, 235, 0.08);
}

#activeTaskStrip .task-progress-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

#activeTaskStrip .task-progress-head > div:first-child {
  display: grid;
  gap: 8px;
  min-width: 0;
}

#activeTaskStrip .task-status-pill {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 5px 10px;
  border-radius: 999px;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

#activeTaskStrip .task-progress-head strong {
  color: #0f172a;
  font-size: 18px;
  line-height: 1.35;
}

#activeTaskStrip .task-progress-percent {
  flex: 0 0 auto;
  color: #1d4ed8;
  font-size: 30px;
  font-weight: 800;
  line-height: 1;
}

#activeTaskStrip .task-progress-meter {
  height: 14px;
  border-radius: 999px;
  overflow: hidden;
  background: #e5edf9;
  border: 1px solid #d7e3f4;
}

#activeTaskStrip .task-progress-meter span {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 55%, #60a5fa 100%);
}

#activeTaskStrip.running .task-progress-meter span {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(90deg, #2563eb 0%, #3b82f6 45%, #60a5fa 70%, #2563eb 100%),
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.22) 0 10px, rgba(255, 255, 255, 0) 10px 20px);
  background-size: 220% 100%, 28px 28px;
  animation: qa-progress-flow 1.8s linear infinite;
}

#activeTaskStrip.running .task-progress-meter span::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.55) 48%, transparent 100%);
  transform: translateX(-100%);
  animation: qa-progress-sheen 2.4s ease-in-out infinite;
}

#activeTaskStrip.running .task-progress-percent {
  animation: qa-progress-pulse 1.8s ease-in-out infinite;
}

@keyframes qa-progress-flow {
  from {
    background-position: 0% 0, 0 0;
  }
  to {
    background-position: 220% 0, 28px 0;
  }
}

@keyframes qa-progress-sheen {
  0% {
    transform: translateX(-120%);
  }
  55%,
  100% {
    transform: translateX(120%);
  }
}

@keyframes qa-progress-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.78;
  }
}

@media (prefers-reduced-motion: reduce) {
  #activeTaskStrip.running .task-progress-meter span,
  #activeTaskStrip.running .task-progress-meter span::after,
  #activeTaskStrip.running .task-progress-percent {
    animation: none;
  }
}

#activeTaskStrip .task-progress-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

#activeTaskStrip .task-progress-grid article {
  min-width: 0;
  padding: 12px 13px;
  border: 1px solid #dce6f5;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.96);
}

#activeTaskStrip .task-progress-grid span,
#activeTaskStrip .task-progress-grid small {
  display: block;
  color: #64748b;
  font-size: 12px;
}

#activeTaskStrip .task-progress-grid strong {
  display: block;
  margin-top: 4px;
  color: #0f172a;
  font-size: 18px;
  line-height: 1.2;
}

#activeTaskStrip .task-progress-detail {
  margin: 0;
  color: #475569;
  font-size: 13px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

#activeTaskStrip .current-import-card {
  display: grid;
  gap: 7px;
  padding: 12px 14px;
  border: 1px solid #cfe0fb;
  border-radius: 10px;
  background: #f8fbff;
}

#activeTaskStrip .current-import-card span {
  color: #2563eb;
  font-size: 12px;
  font-weight: 800;
}

#activeTaskStrip .current-import-card strong {
  color: #0f172a;
  font-size: 14px;
  line-height: 1.35;
}

#activeTaskStrip .current-import-card p {
  margin: 0;
  color: #334155;
  font-size: 13px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

#activeTaskStrip .current-import-card small {
  color: #64748b;
  font-size: 12px;
}

#activeTaskStrip .current-import-card.loading {
  border-style: dashed;
}

@media (max-width: 900px) {
  #activeTaskStrip .task-progress-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  #activeTaskStrip.task-strip {
    padding: 14px;
  }

  #activeTaskStrip .task-progress-head {
    flex-direction: column;
    align-items: flex-start;
  }

#activeTaskStrip .task-progress-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* Final chat input polish. */
#chatView .agent-chat-panel {
  overflow: hidden;
  border-color: #dce6f2;
  background: #ffffff;
}

#chatView .chat-transcript {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px;
  background:
    linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
}

#chatView .chat-bubble {
  width: fit-content;
  max-width: min(78%, 760px);
  padding: 12px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
}

#chatView .chat-bubble.user {
  align-self: flex-end;
  border-color: #bfdbfe;
  border-radius: 14px 14px 4px 14px;
  background: #eff6ff;
  color: #0f172a;
}

#chatView .chat-bubble.assistant {
  align-self: flex-start;
  border-radius: 14px 14px 14px 4px;
}

#chatView .chat-bubble.pending-archive {
  border-color: #f3d28b;
  background: #fffaf0;
}

#chatView .chat-bubble.archive-error {
  border-color: #f2b8b5;
  background: #fff7f6;
}

#chatView .chat-bubble.user strong,
#chatView .chat-bubble.user p {
  color: #0f172a;
}

#chatView .chat-bubble strong {
  display: block;
  margin-bottom: 4px;
  color: #2563eb;
  font-size: 12px;
  font-weight: 800;
}

#chatView .chat-bubble p {
  margin: 0;
  color: #1f2937;
  line-height: 1.72;
}

#chatView .chat-composer {
  display: grid;
  gap: 10px;
  padding: 14px;
  border-top: 1px solid #e5edf6;
  background: #f8fafc;
}

#chatView .chat-composer textarea {
  min-height: 112px;
  width: 100%;
  resize: vertical;
  padding: 14px 15px;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  background: #ffffff;
  color: #0f172a;
  font-size: 14px;
  line-height: 1.65;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

#chatView .chat-composer textarea::placeholder {
  color: #94a3b8;
}

#chatView .chat-composer textarea:focus {
  border-color: #2563eb;
  outline: none;
  box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.13),
    0 8px 18px rgba(15, 23, 42, 0.06);
}

#chatView .chat-composer .panel-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin: 0;
}

#chatView .chat-composer button {
  min-height: 36px;
  padding-inline: 14px;
  border-radius: 9px;
}

.memory-card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.memory-card-actions button {
  min-height: 30px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
}

@media (max-width: 720px) {
  #chatView .chat-bubble {
    max-width: 92%;
  }

  #chatView .chat-transcript {
    padding: 14px;
  }
}

/* Open-source IA refresh: top account bar + single-purpose left navigation. */
.app-shell {
  grid-template-columns: 232px minmax(0, 1fr);
}

.app-sidebar {
  padding: 18px 14px;
  background: #ffffff;
  border-right: 1px solid #e5e7eb;
}

.brand-block {
  margin-bottom: 18px;
  padding: 0 8px 14px;
  border-bottom: 1px solid #eef2f7;
}

.brand-block strong {
  font-size: 18px;
  letter-spacing: 0;
}

.side-nav {
  gap: 18px;
}

.nav-group {
  gap: 7px;
}

.nav-group > span,
.nav-more summary {
  padding: 0 10px;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0;
}

.nav-item {
  justify-content: flex-start;
  min-height: 38px;
  padding: 9px 11px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #334155;
  font-size: 13px;
  font-weight: 700;
  text-align: left;
}

.nav-item:hover {
  background: #f8fafc;
  border-color: #e5edf5;
  color: #1e293b;
}

.nav-item.active {
  background: #eef6ff;
  border-color: #bfdcff;
  color: #0f4c9a;
  box-shadow: none;
}

.nav-item.active:hover {
  background: #e5f1ff;
  border-color: #93c5fd;
  color: #0f4c9a;
}

.sidebar-status {
  margin-top: auto;
  border-radius: 8px;
  background: #f8fafc;
  color: #475569;
}

.account-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: minmax(220px, 0.8fr) minmax(300px, 1fr) minmax(360px, 1.1fr);
  gap: 12px;
  align-items: center;
  padding: 12px 18px;
  border: 1px solid #e5e7eb;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(10px);
}

.account-picker-row {
  grid-template-columns: max-content minmax(0, 1fr);
}

.account-create-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) max-content max-content;
  gap: 8px;
  align-items: center;
}

.account-create-row input,
.account-picker-row select {
  min-height: 36px;
  border-radius: 8px;
}

.account-create-row button {
  min-height: 36px;
  white-space: nowrap;
}

#deleteAccount:not(:disabled),
.account-topbar:hover #deleteAccount:not(:disabled),
#deleteAccount:not(:disabled):focus-visible {
  display: inline-flex;
  opacity: 1;
}

.account-run-note {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.account-run-note span,
.readiness-chip {
  border-radius: 999px;
}

.view-hero {
  margin-top: 16px;
  margin-bottom: 14px;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.view-hero .label {
  color: #64748b;
}

.view-hero h1 {
  font-size: 26px;
}

.view-hero p {
  max-width: 860px;
}

.locomo-flow-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 18px;
}

.locomo-flow-grid[hidden] {
  display: none;
}

.flow-card {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  grid-template-rows: auto auto;
  gap: 2px 9px;
  align-items: center;
  height: 76px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  color: #1e293b;
  text-align: left;
  box-shadow: none;
}

.flow-card:focus,
.flow-card:focus-visible {
  outline: none;
  box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.28);
}

.flow-card:hover {
  border-color: #93c5fd;
  background: #f8fbff;
}

.flow-card.active {
  border-color: #60a5fa;
  background: #eff6ff;
  box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.16);
}

.flow-card span {
  grid-row: 1 / span 2;
  display: inline-grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 999px;
  background: #e2e8f0;
  color: #334155;
  font-size: 12px;
  font-weight: 900;
}

.flow-card.active span {
  background: #2563eb;
  color: #ffffff;
}

.flow-card.flow-ok {
  border-bottom-color: #4fb37a;
}

.flow-card.flow-warn,
.flow-card.flow-todo {
  border-bottom-color: #d99a20;
}

.flow-card.flow-bad {
  border-bottom-color: #dc2626;
}

.flow-card.flow-running {
  border-bottom-color: #2563eb;
}

.flow-card.flow-ok span {
  background: #e8f8ef;
  color: #14754f;
}

.flow-card.flow-warn span,
.flow-card.flow-todo span {
  background: #fff4d6;
  color: #a16207;
}

.flow-card.flow-bad span {
  background: #fee2e2;
  color: #b42318;
}

.flow-card.flow-running span {
  background: #dbeafe;
  color: #1d4ed8;
}

.flow-card.active span {
  background: #2563eb;
  color: #ffffff;
}

.flow-card strong,
.flow-card small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flow-card strong {
  font-size: 13px;
}

.flow-card small {
  color: #64748b;
  font-size: 11px;
}

.locomo-command-center {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: -4px 0 18px;
}

.locomo-command-center[hidden] {
  display: none;
}

.overview-card {
  min-width: 0;
  padding: 14px;
  border: 1px solid #dbe4ef;
  border-radius: 8px;
  background: #ffffff;
  display: grid;
  gap: 10px;
}

.overview-card.ok {
  border-color: #b7dfca;
  background: #f7fcf9;
}

.overview-card.warn {
  border-color: #f2d28c;
  background: #fffaf0;
}

.overview-card.bad {
  border-color: #f1b5b5;
  background: #fff7f7;
}

.overview-card.todo {
  border-color: #d8e0ea;
  background: #f8fafc;
}

.overview-card.muted {
  border-color: #e2e8f0;
  background: #f8fafc;
  color: #64748b;
}

.overview-card.active {
  border-color: #93c5fd;
  background: #f5f9ff;
}

.overview-card.reference {
  border-color: #c7d7eb;
  background: #f8fbff;
}

.locomo-flow-hero {
  grid-column: 1 / -1;
  gap: 12px;
  padding: 16px;
  border-color: #bfd3ee;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
}

.locomo-flow-hero .overview-card-head strong {
  font-size: 15px;
}

.flow-progress-line {
  height: 9px;
  overflow: hidden;
  border-radius: 999px;
  background: #e4ecf7;
}

.flow-progress-line i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #2563eb, #22a36a);
}

.flow-current-step {
  display: grid;
  gap: 8px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #d9e5f3;
  border-left: 4px solid #94a3b8;
  border-radius: 8px;
  background: #ffffff;
}

.flow-current-step.flow-ok {
  border-left-color: #22a36a;
}

.flow-current-step.flow-warn,
.flow-current-step.flow-todo {
  border-left-color: #d99a20;
}

.flow-current-step.flow-bad {
  border-left-color: #dc2626;
}

.flow-current-step.flow-running {
  border-left-color: #2563eb;
}

.flow-current-step span,
.flow-artifact-head span,
.locomo-stage-rail em {
  color: #64748b;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.flow-current-step strong {
  color: #10233f;
  font-size: 18px;
  line-height: 1.2;
}

.locomo-stage-rail {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 8px;
}

.locomo-stage-rail button {
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr);
  grid-template-rows: auto auto;
  gap: 2px 8px;
  align-items: center;
  min-width: 0;
  min-height: 62px;
  padding: 9px;
  border: 1px solid #dbe4ef;
  border-radius: 8px;
  background: #ffffff;
  text-align: left;
}

.locomo-stage-rail button:hover {
  border-color: #93c5fd;
  background: #f8fbff;
}

.locomo-stage-rail span {
  grid-row: 1 / span 2;
  display: inline-grid;
  width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 999px;
  background: #e2e8f0;
  color: #334155;
  font-size: 11px;
  font-weight: 900;
}

.locomo-stage-rail strong,
.locomo-stage-rail em {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.locomo-stage-rail strong {
  color: #172033;
  font-size: 12px;
}

.locomo-stage-rail .flow-ok span {
  background: #e8f8ef;
  color: #14754f;
}

.locomo-stage-rail .flow-warn span,
.locomo-stage-rail .flow-todo span {
  background: #fff4d6;
  color: #a16207;
}

.locomo-stage-rail .flow-bad span {
  background: #fee2e2;
  color: #b42318;
}

.locomo-stage-rail .flow-running span {
  background: #dbeafe;
  color: #1d4ed8;
}

.flow-artifact-panel {
  display: grid;
  gap: 10px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dbe7f7;
  border-radius: 8px;
  background: #ffffff;
}

.flow-artifact-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  align-items: baseline;
}

.flow-artifact-head strong {
  color: #334155;
  font-size: 12px;
}

.flow-artifact-list {
  display: grid;
  gap: 8px;
}

.flow-artifact-row {
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr) auto auto;
  gap: 8px;
  align-items: center;
  min-width: 0;
  padding: 8px;
  border: 1px solid #edf2f7;
  border-radius: 7px;
  background: #fbfdff;
}

.flow-artifact-row span {
  color: #64748b;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.flow-artifact-row code {
  min-width: 0;
  overflow-wrap: anywhere;
  white-space: normal;
}

.locomo-stage-card {
  position: relative;
  align-content: start;
}

.locomo-stage-card::before {
  content: "";
  position: absolute;
  top: 14px;
  left: 0;
  width: 3px;
  height: calc(100% - 28px);
  border-radius: 999px;
  background: #cbd5e1;
}

.locomo-stage-card.ok::before {
  background: #22a36a;
}

.locomo-stage-card.warn::before,
.locomo-stage-card.todo::before {
  background: #d99a20;
}

.locomo-stage-card.bad::before {
  background: #dc2626;
}

.locomo-stage-card.active::before {
  background: #2563eb;
}

.overview-card-head {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: baseline;
}

.overview-card-head span {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.overview-card-head strong {
  min-width: 0;
  color: #172033;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.overview-card p {
  margin: 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.overview-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.overview-metric {
  min-width: 0;
  padding: 8px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #ffffff;
}

.overview-metric span {
  display: block;
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
}

.overview-metric strong {
  display: block;
  color: #172033;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.overview-metric.ok strong {
  color: #14754f;
}

.overview-metric.warn strong {
  color: #a16207;
}

.overview-metric.bad strong {
  color: #b42318;
}

.overview-metric.active strong {
  color: #2563eb;
}

.locomo-next-actions {
  margin: 0;
  padding: 10px 12px 10px 28px;
  border: 1px solid #dbe7f7;
  border-radius: 8px;
  background: #ffffff;
  color: #334155;
  font-size: 12px;
  line-height: 1.5;
}

.locomo-next-actions li + li {
  margin-top: 4px;
}

.locomo-stage-details {
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid #e2e8f0;
  border-radius: 7px;
  background: #ffffff;
}

.locomo-stage-details summary {
  color: #24527a;
  cursor: pointer;
  font-size: 12px;
  font-weight: 850;
}

.locomo-stage-details[open] summary {
  margin-bottom: 8px;
}

.locomo-stage-evidence {
  display: grid;
  gap: 7px;
}

.locomo-stage-evidence > div {
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  min-width: 0;
}

.locomo-stage-evidence span {
  color: #64748b;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.locomo-stage-evidence code {
  min-width: 0;
  overflow-wrap: anywhere;
  white-space: normal;
}

.overview-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.overview-actions a {
  min-height: 30px;
  padding: 6px 10px;
  border: 1px solid #bfd3ee;
  border-radius: 6px;
  background: #ffffff;
  color: #244f7a;
  font-size: 12px;
  font-weight: 800;
}

.category-badge {
  display: inline-flex;
  width: max-content;
  max-width: 100%;
  align-items: center;
  gap: 6px;
  padding: 3px 8px;
  border: 1px solid #d7e2ee;
  border-radius: 999px;
  background: #f3f7fb;
  color: #315b7d;
  font-size: 11px;
  font-weight: 850;
  line-height: 1.2;
  white-space: normal;
  overflow-wrap: anywhere;
}

.category-badge.category-2 {
  border-color: #cbdaf7;
  background: #eef4ff;
  color: #285fbe;
}

.category-badge.category-3 {
  border-color: #d7c9f2;
  background: #f6f1ff;
  color: #6743a3;
}

.category-badge.category-4 {
  border-color: #d5ead9;
  background: #f2faf4;
  color: #247047;
}

.import-console {
  display: grid;
  gap: 18px;
}

.import-console > .panel-head {
  padding-bottom: 14px;
  border-bottom: 1px solid #e2e8f0;
}

.import-console > .panel-head p {
  max-width: 760px;
  margin: 6px 0 0;
  color: #5c6f89;
  font-size: 13px;
  line-height: 1.55;
}

.backend-connection-config {
  display: grid;
  gap: 12px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #e2e8f0;
}

.backend-connection-config .section-title-row.compact {
  align-items: center;
  gap: 10px;
}

.backend-connection-config h4 {
  margin: 0;
  color: #10233f;
  font-size: 14px;
}

.backend-connection-config .check-list:empty {
  display: none;
}

.import-section {
  display: grid;
  gap: 12px;
  padding: 16px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
}

.import-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
}

.import-section-head h3 {
  margin: 0;
  color: #10233f;
  font-size: 16px;
  line-height: 1.25;
}

.import-section-head p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 12px;
  line-height: 1.5;
}

.import-diagnostic-panel {
  display: grid;
  gap: 8px;
}

.import-diagnostic-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 12px;
  border: 1px solid #dbe5f2;
  border-radius: 6px;
  background: #f8fafc;
}

.import-diagnostic-summary strong {
  color: #10233f;
  font-size: 13px;
}

.import-diagnostic-summary span {
  color: #64748b;
  font-size: 12px;
  text-align: right;
}

.import-secondary-details {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #fbfdff;
}

.import-secondary-details summary {
  min-height: 40px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  color: #40516a;
  cursor: pointer;
  font-size: 13px;
  font-weight: 800;
}

.import-secondary-details[open] {
  padding-bottom: 12px;
}

.import-secondary-details[open] summary {
  margin-bottom: 10px;
  border-bottom: 1px solid #e2e8f0;
}

.import-secondary-details .path-list,
.import-secondary-details .memory-list,
.import-secondary-details .panel-actions {
  margin-left: 12px;
  margin-right: 12px;
}

.compact-memory {
  margin-top: 0;
}

.import-readiness-panel {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin: 0;
}

.import-readiness-panel article {
  min-width: 0;
  padding: 13px;
  border: 1px solid #dbe5f2;
  border-radius: 8px;
  background: #fbfdff;
  display: grid;
  gap: 6px;
}

.import-readiness-panel article.ok {
  border-color: #b7dfca;
  background: #f7fcf9;
}

.import-readiness-panel article.warn {
  border-color: #f0d28c;
  background: #fffaf0;
}

.import-readiness-panel article.active {
  border-color: #93c5fd;
  background: #f5f9ff;
}

.import-readiness-panel span {
  color: #64748b;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.import-readiness-panel strong {
  min-width: 0;
  color: #10233f;
  font-size: 15px;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.import-readiness-panel p {
  min-width: 0;
  margin: 0;
  color: #5c6f89;
  font-size: 12px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.import-stage-rail {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 8px;
  margin: 12px 0;
}

.import-stage-rail span {
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 8px;
  border: 1px solid #dbe4ef;
  border-radius: 999px;
  background: #ffffff;
  color: #64748b;
  font-size: 11px;
  font-weight: 850;
  text-align: center;
}

.import-stage-rail span.done {
  border-color: #aad7bc;
  background: #f1faf5;
  color: #166b45;
}

.import-stage-rail span.active {
  border-color: #8fbcf7;
  background: #eff6ff;
  color: #1d5fb8;
}

.import-stage-rail span.warn {
  border-color: #f0c776;
  background: #fff8e8;
  color: #9a5b13;
}

@media (max-width: 1180px) {
  .locomo-command-center {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .locomo-stage-rail {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .import-stage-rail {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .import-readiness-panel {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .locomo-command-center,
  .overview-metrics,
  .locomo-stage-rail,
  .import-stage-rail,
  .import-readiness-panel {
    grid-template-columns: minmax(0, 1fr);
  }

  .import-section-head,
  .import-diagnostic-summary {
    flex-direction: column;
    align-items: flex-start;
  }

  .import-diagnostic-summary span {
    text-align: left;
  }

  .flow-artifact-row,
  .locomo-stage-evidence > div {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 1180px) {
  .account-topbar {
    grid-template-columns: minmax(0, 1fr);
  }

  .locomo-flow-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .system-preflight-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .app-shell {
    grid-template-columns: minmax(0, 1fr);
  }

  .account-create-row,
  .account-picker-row {
    grid-template-columns: minmax(0, 1fr);
  }

  .locomo-flow-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .system-preflight-grid,
  .backend-isolation-hero,
  .backend-isolation-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .backend-isolation-actions {
    justify-content: flex-start;
  }
}

/* Final stability pass: keep the account bar from reflowing between workflow pages. */
html {
  scrollbar-gutter: stable;
}

.account-topbar {
  box-sizing: border-box;
  overflow: hidden;
  transition: none;
}

.account-control,
.account-picker-row,
.account-scope,
.account-readiness,
.account-run-note,
.account-create-row {
  box-sizing: border-box;
  min-width: 0;
}

.account-picker-row {
  display: grid;
  align-items: center;
  gap: 8px;
  grid-template-columns: max-content minmax(0, 1fr);
  max-width: none;
  margin: 0;
  padding: 0;
}

.account-picker-row .label,
.account-run-note span,
.readiness-chip {
  white-space: nowrap;
}

.account-scope {
  display: flex;
  align-items: center;
  gap: 6px;
  overflow: hidden;
}

.account-scope:has(.global-task-chip:not([hidden])) {
  overflow: visible;
}

.account-readiness {
  flex: 0 0 auto;
}

.account-run-note {
  flex: 1 1 auto;
  flex-wrap: nowrap;
  overflow: hidden;
}

.account-run-note span {
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (min-width: 981px) {
  .account-topbar {
    grid-template-columns: minmax(210px, 0.85fr) minmax(320px, 1fr) minmax(320px, 1fr);
    grid-template-rows: 48px;
    align-items: center;
    height: 70px;
    min-height: 70px;
    padding: 10px 12px;
  }

  .account-control,
  .account-picker-row,
  .account-create-row {
    height: 36px;
  }

  .account-scope {
    height: 48px;
  }

  .account-create-row {
    grid-template-columns: minmax(0, 1fr) max-content max-content;
  }
}

@media (max-width: 980px) {
  .account-topbar {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 32px 46px 32px;
    align-items: center;
    gap: 8px;
    height: 142px;
    min-height: 142px;
    padding: 10px 12px;
  }

  .account-control,
  .account-picker-row,
  .account-scope,
  .account-create-row {
    width: 100%;
  }

  .account-control,
  .account-picker-row {
    height: 32px;
  }

  .account-scope {
    height: 46px;
  }

  .account-create-row {
    grid-template-columns: minmax(0, 1fr) max-content max-content;
    height: 32px;
  }

  .account-topbar .account-control select,
  .account-topbar .account-create-row input {
    width: 100%;
  }
}

/* Keep the current-page title block stable while only its text changes. */
.view-hero {
  box-sizing: border-box;
  display: grid;
  align-items: center;
  height: 96px;
  min-height: 96px;
  overflow: hidden;
  transition: none;
}

.view-hero > div {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.view-hero .label,
.view-hero h1,
.view-hero p {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.view-hero .label {
  height: 16px;
  line-height: 16px;
}

.view-hero h1 {
  height: 32px;
  margin: 0;
  line-height: 32px;
}

.view-hero p {
  height: 22px;
  margin: 0;
  line-height: 22px;
}

@media (max-width: 1180px) {
  .run-audit-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .run-audit-head,
  .run-audit-section-title {
    display: grid;
  }

  .run-audit-chips {
    justify-content: flex-start;
  }

  .run-audit-section-title small {
    max-width: none;
    text-align: left;
  }
}

@media (max-width: 760px) {
  .run-audit-grid {
    grid-template-columns: 1fr;
  }
}

/* Agent workbench: make memory scope, read/write boundary, and archive state visible. */
#chatView .chat-boundary-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 12px;
  padding: 14px 16px;
  border: 1px solid #dbe4ef;
  border-left: 4px solid #2563eb;
  border-radius: 8px;
  background: #f8fbff;
}

#chatView .chat-boundary-banner h2 {
  margin: 4px 0 6px;
  color: #0f172a;
  font-size: 17px;
}

#chatView .chat-boundary-banner p {
  margin: 0;
  max-width: 820px;
  color: #475569;
  font-size: 13px;
  line-height: 1.55;
}

#chatView .chat-boundary-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}

#chatView .chat-debug-strip {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
  margin-bottom: 10px;
}

#chatView .chat-debug-card {
  min-width: 0;
  padding: 12px 13px;
  border: 1px solid #dbe4ef;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

#chatView .chat-debug-card.primary {
  border-color: #bfdbfe;
  background: #eff6ff;
}

#chatView .chat-debug-card.ok {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

#chatView .chat-debug-card.warn {
  border-color: #fde68a;
  background: #fffbeb;
}

#chatView .chat-debug-card span {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

#chatView .chat-debug-card strong {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #0f172a;
  font-size: 14px;
  font-weight: 850;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

#chatView .chat-debug-card p {
  margin: 7px 0 0;
  min-width: 0;
  overflow: hidden;
  color: #64748b;
  font-size: 12px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

#chatView .chat-suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

#chatView .chat-suggestion-row button {
  min-height: 30px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 750;
}

#chatView .mini-archive-status .archive-status {
  display: grid;
  gap: 8px;
}

#chatView .archive-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid #e5edf6;
  border-radius: 8px;
  background: #f8fafc;
}

#chatView .archive-line.ok {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

#chatView .archive-line.warn {
  border-color: #fde68a;
  background: #fffbeb;
}

#chatView .archive-line strong,
#chatView .archive-line span {
  font-size: 12px;
}

@media (max-width: 1180px) {
  #chatView .chat-debug-strip {
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  }
}

@media (max-width: 720px) {
  #chatView .chat-boundary-banner {
    align-items: stretch;
    flex-direction: column;
  }

  #chatView .chat-boundary-actions {
    justify-content: flex-start;
  }

  #chatView .chat-debug-strip {
    grid-template-columns: 1fr;
  }
}

/* Route stability fix: keep dataset navigation clickable while long benchmark pages scroll. */
@media (min-width: 560px) {
  .app-shell {
    display: block;
    overflow-x: visible;
  }

  .app-sidebar {
    position: fixed !important;
    top: 0;
    left: 0;
    z-index: 30;
    height: 100vh;
    max-height: 100vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .app-content {
    width: auto;
    max-width: none;
    margin-left: 218px;
  }

  .side-nav {
    min-height: 0;
    overflow-y: auto;
    padding-right: 2px;
  }
}

/* 2026-06-07 v16: stabilize the real review pain points from the local UI audit. */
.nav-item,
.nav-item:hover,
.nav-item:focus-visible,
.nav-item.active,
.nav-item.active:hover {
  color: #1e293b;
}

.nav-item.active,
.nav-item.active:hover {
  color: #0f4c9a;
}

.locomo-flow-grid {
  min-height: 76px;
}

.flow-card[hidden] {
  display: none !important;
}

.flow-card strong {
  color: #172033;
}

.flow-card small {
  color: #64748b;
}

.flow-card:hover strong,
.flow-card:hover small {
  color: inherit;
}

.flow-card:disabled,
.flow-card[aria-disabled="true"] {
  cursor: default;
}

.flow-card:disabled:hover,
.flow-card[aria-disabled="true"]:hover {
  border-color: #60a5fa;
  background: #eff6ff;
}

body[data-active-view="openvikingView"] .view-hero,
body[data-active-view="evalView"] .view-hero,
body[data-active-view="judgeView"] .view-hero,
body[data-active-view="runsView"] .view-hero,
body[data-active-view="memoryView"] .view-hero,
body[data-active-view="datasetView"] .view-hero {
  display: grid !important;
}

@media (min-width: 921px) {
  .app-sidebar {
    width: 232px;
  }

  .app-content {
    margin-left: 232px;
  }
}

@media (max-width: 920px) {
  body {
    overflow-x: hidden;
  }

  .app-shell {
    display: block !important;
    overflow-x: hidden;
  }

  .app-sidebar {
    position: sticky !important;
    top: 0;
    left: auto;
    z-index: 40;
    display: block !important;
    width: auto;
    height: auto;
    max-height: none;
    min-height: 0 !important;
    padding: 8px 10px 10px;
    border-right: 0;
    border-bottom: 1px solid #dbe4ef;
    background: rgba(255, 255, 255, 0.98);
    overflow: hidden;
  }

  .brand-block {
    display: none !important;
  }

  .side-nav {
    display: block;
    height: 38px;
    min-width: 0;
    min-height: 0 !important;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 2px;
    scrollbar-width: none;
  }

  .side-nav::-webkit-scrollbar {
    display: none;
  }

  .nav-group {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    height: 38px;
    min-width: max-content;
    margin: 0;
    padding: 0;
  }

  .nav-group > span {
    display: none;
  }

  .nav-item {
    flex: 0 0 auto;
    min-height: 34px;
    max-width: 132px;
    padding: 7px 10px;
    overflow: hidden;
    border-color: #e5edf5;
    background: #ffffff;
    color: #334155;
    font-size: 12px;
    line-height: 18px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-item:hover,
  .nav-item.active:hover {
    background: #f8fbff;
    color: #0f172a;
  }

  .nav-item.active {
    border-color: #93c5fd;
    background: #eaf3ff;
    color: #0f4c9a;
  }

  .sidebar-status {
    display: none !important;
  }

  .app-content {
    width: auto;
    max-width: none;
    margin-left: 0 !important;
    padding: 10px;
  }

  .account-topbar {
    position: static;
    grid-template-rows: 32px 30px 32px;
    height: 126px;
    min-height: 126px;
    margin: 0;
    border-radius: 8px;
  }

  .view-hero {
    height: 82px;
    min-height: 82px;
    margin: 10px 0;
    padding: 10px 12px;
    border: 1px solid #e5edf5;
    border-radius: 8px;
    background: #ffffff;
  }

  .view-hero h1 {
    height: 28px;
    font-size: 22px;
    line-height: 28px;
  }

  .view-hero p {
    height: 20px;
    line-height: 20px;
  }

  .locomo-flow-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    min-height: 76px;
    margin: 0 0 16px;
    overflow: visible;
  }

  .locomo-flow-grid::-webkit-scrollbar {
    display: none;
  }

  .flow-card {
    grid-template-columns: 28px minmax(0, 1fr);
    height: 76px;
    min-height: 76px;
    padding: 12px;
  }

  .flow-card span {
    width: 28px;
    height: 28px;
  }

  .flow-card small {
    display: block;
  }

  .panel,
  .view-panel.active {
    max-width: 100%;
  }
}

@media (max-width: 520px) {
  .app-sidebar {
    grid-template-columns: minmax(0, 1fr);
  }

  .brand-block,
  .sidebar-status {
    display: none;
  }

  .account-create-row {
    grid-template-columns: minmax(0, 1fr) max-content;
  }

  #deleteAccount {
    display: none !important;
  }
}

/* Simplified manual chat bench: keep the page focused on chat and evidence. */
#chatView .chat-boundary-banner,
#chatView .chat-debug-strip,
#chatView .chat-suggestion-row,
#chatView .tab-strip[hidden] {
  display: none !important;
}

#chatView .chat-page-toolbar {
  justify-content: flex-end;
  min-height: 38px;
  margin-bottom: 10px;
}

#chatView .chat-persona-card {
  display: grid;
  grid-template-columns: minmax(160px, max-content) minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
  padding: 10px 12px;
  border: 1px solid #dbe5f2;
  border-radius: 8px;
  background: #ffffff;
}

#chatView .chat-path-card {
  grid-template-columns: minmax(0, 1fr);
  padding: 8px 12px;
}

#chatView .chat-persona-card span,
#chatView .memory-panel-head span {
  display: block;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
}

#chatView .chat-persona-card strong,
#chatView .memory-panel-head strong {
  color: #172033;
  font-size: 13px;
}

#chatView .chat-persona-card p {
  margin: 0;
  color: #475569;
  font-size: 12px;
  line-height: 1.5;
}

#chatView .chat-system-summary-card {
  margin-top: -2px;
  border-color: #bfd7f0;
  background: #f7fbff;
}

#chatView .system-persona-summary {
  display: grid;
  gap: 8px;
  grid-column: 1 / -1;
  width: 100%;
}

#chatView .system-persona-summary > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

#chatView .system-persona-summary pre {
  margin: 0;
  max-height: 96px;
  padding: 8px 10px;
  border: 1px solid #dbe8f5;
  border-radius: 8px;
  background: #ffffff;
  color: #334155;
  font-size: 12px;
  line-height: 1.55;
  white-space: pre-wrap;
  overflow: auto;
}

#chatView .memory-space-inline {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr) max-content max-content max-content;
  gap: 8px;
  align-items: center;
  min-width: 0;
  padding-top: 8px;
  border-top: 1px solid #edf2f7;
}

#chatView .chat-path-card .memory-space-inline {
  padding-top: 0;
  border-top: 0;
}

#chatView .memory-space-inline span {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
}

#chatView .memory-space-inline code {
  min-width: 0;
  padding: 6px 8px;
  border: 1px solid #e5edf5;
  border-radius: 6px;
  background: #f8fbff;
  color: #334155;
  font-size: 11px;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#chatView .memory-space-count,
#chatView .memory-space-empty,
#chatView .memory-space-model {
  min-width: max-content;
  padding: 4px 8px;
  border: 1px solid #d9ead7;
  border-radius: 999px;
  background: #f4fbf3;
  color: #2f6b3f;
  font-size: 11px;
  font-style: normal;
  font-weight: 800;
}

#chatView .memory-space-empty {
  border-color: #f4c7c3;
  background: #fff7f6;
  color: #9f2f24;
}

#chatView .memory-space-model {
  border-color: #d6e4f5;
  background: #f7fbff;
  color: #24527a;
}

#chatView .memory-space-alert {
  padding: 10px 12px;
  border: 1px solid #f4c7c3;
  border-radius: 8px;
  background: #fff7f6;
  color: #7f1d1d;
  font-size: 12px;
  line-height: 1.55;
}

#chatView .agent-workbench,
#chatView .agent-workbench.context-collapsed {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
  gap: 12px;
  align-items: stretch;
}

#chatView .agent-chat-panel {
  min-width: 0;
  height: min(760px, calc(100vh - 190px));
  min-height: 620px;
  grid-template-rows: auto minmax(0, 1fr) auto;
}

#chatView .chat-composer textarea {
  width: 100%;
  min-height: 126px;
  box-sizing: border-box;
}

#chatView .memory-evidence {
  min-width: 0;
  height: min(760px, calc(100vh - 190px));
  min-height: 620px;
  display: grid;
  grid-template-rows: auto minmax(220px, 1.25fr) minmax(180px, 1fr) auto;
  gap: 12px;
}

#chatView .memory-evidence .agent-card {
  min-height: 0;
  overflow: hidden;
}

#chatView .memory-panel-head {
  display: grid;
  gap: 2px;
  padding: 12px 12px 8px;
  border-bottom: 1px solid #e5edf5;
}

#chatView .context-persona-panel {
  display: grid;
  gap: 4px;
  margin: 12px 12px 0;
  padding: 10px 12px;
  border: 1px solid #dbe5f2;
  border-radius: 8px;
  background: #f8fbff;
}

#chatView .context-persona-panel span {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
}

#chatView .context-persona-panel strong {
  color: #172033;
  font-size: 13px;
}

#chatView .context-persona-panel p,
#chatView .context-persona-panel pre {
  margin: 0;
  color: #475569;
  font-size: 12px;
  line-height: 1.5;
}

#chatView .context-persona-panel pre {
  max-height: 150px;
  padding: 8px;
  border: 1px solid #e5edf5;
  border-radius: 6px;
  background: #ffffff;
  white-space: pre-wrap;
  overflow: auto;
}

#chatView #chatPersonaBody {
  white-space: pre-wrap;
}

#chatView .memory-space-details {
  display: grid;
  gap: 8px;
  padding: 12px;
}

#chatView .memory-space-row,
#chatView .memory-space-path {
  display: grid;
  gap: 4px;
  min-width: 0;
}

#chatView .memory-space-row {
  grid-template-columns: 56px minmax(0, 1fr);
  align-items: center;
}

#chatView .memory-space-details span {
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
}

#chatView .memory-space-details strong {
  min-width: 0;
  color: #172033;
  font-size: 13px;
  overflow-wrap: anywhere;
}

#chatView .memory-space-details code {
  display: block;
  min-width: 0;
  max-width: 100%;
  padding: 8px;
  border: 1px solid #e5edf5;
  border-radius: 6px;
  background: #f8fbff;
  color: #334155;
  font-size: 11px;
  line-height: 1.45;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

#chatView .memory-list,
#chatView #contextTrace {
  min-height: 0;
  max-height: none;
  padding: 12px;
  overflow: auto;
}

#chatView .chat-transcript {
  min-height: 0;
  max-height: none;
  overflow: auto;
}

#chatView .chat-bubble {
  max-width: min(82%, 760px);
  overflow-wrap: anywhere;
}

#chatView .chat-bubble p,
#chatView .memory-hit p {
  overflow-wrap: anywhere;
}

#chatView .memory-card,
#chatView .context-card {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
}

#chatView .memory-note {
  margin: 0 0 10px;
  padding: 8px 10px;
  border: 1px solid #dbeafe;
  border-radius: 8px;
  background: #f7fbff;
  color: #24527a;
  font-size: 12px;
  font-weight: 700;
}

#chatView .memory-hit-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.account-create-row {
  justify-content: end;
}

.account-create-row #accountNameInput[hidden] {
  display: none !important;
}

.account-create-row:not(.expanded) {
  grid-template-columns: max-content max-content;
}

.account-create-row.expanded {
  grid-template-columns: minmax(150px, 1fr) max-content max-content;
}

.account-create-row.expanded #accountNameInput {
  display: block;
}

#accountReadiness {
  display: none !important;
}

#accountRunNote span {
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
}

/* Header polish: keep account controls legible and aligned. */
.app-content > .account-topbar {
  position: relative;
  z-index: 3;
  display: grid !important;
  grid-template-columns: minmax(220px, 1fr) max-content minmax(140px, 0.8fr) max-content !important;
  align-items: center !important;
  gap: 12px !important;
  min-height: 58px;
  height: auto !important;
  margin: 0 0 12px !important;
  padding: 10px 12px !important;
  overflow: visible !important;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 1px 2px rgb(15 23 42 / 4%);
}

.app-content > .account-topbar .account-control,
.app-content > .account-topbar .account-backend-pill,
.app-content > .account-topbar .account-scope,
.app-content > .account-topbar .account-create-row {
  min-width: 0;
  height: auto !important;
  overflow: visible !important;
}

.app-content > .account-topbar .account-control {
  grid-column: 1 !important;
  grid-row: 1 !important;
}

.app-content > .account-topbar .account-backend-pill {
  grid-column: 2 !important;
  grid-row: 1 !important;
}

.app-content > .account-topbar .account-scope {
  grid-column: 3 !important;
  grid-row: 1 !important;
}

.app-content > .account-topbar .account-create-row {
  grid-column: 4 !important;
  grid-row: 1 !important;
}

.app-content > .account-topbar .account-picker-row {
  display: grid !important;
  grid-template-columns: max-content minmax(0, 1fr) !important;
  align-items: center !important;
  gap: 8px !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0;
}

.app-content > .account-topbar .account-picker-row .label {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  color: #64748b;
  font-size: 12px;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.app-content > .account-topbar .account-control select {
  width: 100% !important;
  min-width: 0;
  height: 36px !important;
  min-height: 36px !important;
  padding: 0 34px 0 10px !important;
  border-color: #cbd5e1;
  color: #0f172a;
  font-size: 13px !important;
  font-weight: 800;
  line-height: 34px !important;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.app-content > .account-topbar .account-backend-pill {
  display: grid;
  grid-template-columns: max-content;
  align-content: center;
  justify-items: start;
  gap: 2px;
  min-width: 118px;
  height: 36px !important;
  min-height: 36px !important;
  margin: 0 !important;
  padding: 4px 10px !important;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #f8fafc;
  color: #0f172a;
  line-height: 1.05;
  text-align: left;
  white-space: nowrap;
  cursor: pointer;
  box-shadow: none;
}

.app-content > .account-topbar .account-backend-pill:hover,
.app-content > .account-topbar .account-backend-pill:focus-visible {
  border-color: #2563eb;
  background: #eff6ff;
  color: #0f172a;
}

.app-content > .account-topbar .account-backend-pill span {
  color: #64748b;
  font-size: 10px;
  font-weight: 900;
  line-height: 1;
}

.app-content > .account-topbar .account-backend-pill strong {
  color: #0f172a;
  font-size: 13px;
  font-weight: 900;
  line-height: 1.05;
}

.app-content > .account-topbar .account-backend-pill.echomemory {
  border-color: #99f6e4;
  background: #f0fdfa;
}

.app-content > .account-topbar .account-backend-pill.echomemory:hover,
.app-content > .account-topbar .account-backend-pill.echomemory:focus-visible {
  border-color: #0f766e;
  background: #ccfbf1;
}

.app-content > .account-topbar .account-scope {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 8px;
  min-height: 36px;
}

.app-content > .account-topbar .account-run-note {
  display: inline-flex !important;
  align-items: center !important;
  min-width: 0;
  max-width: 100%;
  min-height: 32px;
  height: auto !important;
  padding: 6px 10px;
  overflow: hidden !important;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
}

.app-content > .account-topbar .account-run-note span {
  display: block;
  min-width: 0;
  color: #64748b;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.app-content > .account-topbar .global-task-chip {
  min-height: 0;
  align-items: stretch;
  white-space: normal;
}

.app-content > .account-topbar .account-create-row {
  display: grid !important;
  grid-template-columns: max-content max-content !important;
  align-items: center !important;
  justify-content: end !important;
  gap: 8px !important;
}

.app-content > .account-topbar .account-create-row.expanded {
  grid-template-columns: minmax(150px, 1fr) max-content max-content !important;
}

.app-content > .account-topbar .account-create-row input,
.app-content > .account-topbar .account-create-row button {
  height: 36px !important;
  min-height: 36px !important;
  margin: 0 !important;
  line-height: 1 !important;
  white-space: nowrap;
}

.app-content > .account-topbar .account-create-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 12px !important;
}

@media (max-width: 980px) {
  .app-content > .account-topbar {
    grid-template-columns: minmax(0, 1fr) max-content !important;
  }

  .app-content > .account-topbar .account-control {
    grid-column: 1 !important;
    grid-row: 1 !important;
  }

  .app-content > .account-topbar .account-backend-pill {
    grid-column: 2 !important;
    grid-row: 1 !important;
  }

  .app-content > .account-topbar .account-scope {
    grid-column: 1 !important;
    grid-row: 2 !important;
  }

  .app-content > .account-topbar .account-create-row {
    grid-column: 2 !important;
    grid-row: 2 !important;
  }

  .app-content > .account-topbar .account-backend-pill {
    width: auto;
  }

  .app-content > .account-topbar .account-create-row {
    justify-content: end !important;
  }

  .app-content > .account-topbar .account-run-note span {
    white-space: normal;
  }

  #chatView .agent-workbench,
  #chatView .agent-workbench.context-collapsed {
    grid-template-columns: minmax(0, 1fr);
  }

  #chatView .memory-evidence {
    grid-template-rows: auto auto;
  }
}

@media (max-width: 620px) {
  .app-content > .account-topbar {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .app-content > .account-topbar .account-control,
  .app-content > .account-topbar .account-backend-pill,
  .app-content > .account-topbar .account-scope,
  .app-content > .account-topbar .account-create-row {
    grid-column: 1 !important;
    grid-row: auto !important;
  }

  .app-content > .account-topbar .account-backend-pill {
    width: 100%;
  }

  .app-content > .account-topbar .account-create-row {
    justify-content: start !important;
  }
}
