}

.handoff-audit-card li {
  padding: 6px 8px;
  border-radius: 5px;
  background: #f7f9fd;
  color: #53657f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.45;
}

.readiness-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.handoff-dashboard-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  min-width: 0;
}

.handoff-dashboard-card {
  display: grid;
  gap: 9px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #dfe7f1;
  border-left: 4px solid #94a3b8;
  border-radius: 7px;
  background: #ffffff;
}

.handoff-dashboard-card.hero {
  grid-column: span 2;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  background: #fbfcfe;
}

.handoff-dashboard-card.next,
.handoff-dashboard-card.commands {
  background: #fbfcfe;
}

.handoff-dashboard-card.commands {
  grid-column: 1 / -1;
}

.handoff-dashboard-card.ok {
  border-left-color: #2f8f6b;
}

.handoff-dashboard-card.warn,
.handoff-dashboard-card.todo {
  border-left-color: #c48a1d;
}

.handoff-dashboard-card.bad {
  border-left-color: #c94f4f;
}

.handoff-dashboard-card.muted {
  border-left-color: #94a3b8;
}

.handoff-dashboard-card > span,
.handoff-dashboard-card .preflight-card-head span {
  color: #667790;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.handoff-dashboard-card strong,
.handoff-dashboard-card p,
.handoff-dashboard-card li,
.handoff-dashboard-card code,
.handoff-dashboard-card dt,
.handoff-dashboard-card dd,
.handoff-dashboard-card span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.handoff-dashboard-card strong {
  color: #10233f;
  font-size: 14px;
  line-height: 1.45;
}

.handoff-dashboard-card p,
.handoff-dashboard-card li,
.handoff-dashboard-card dt,
.handoff-dashboard-card dd {
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.handoff-dashboard-card p {
  margin: 0;
}

.handoff-dashboard-card code {
  display: inline-block;
  max-width: 100%;
  padding: 2px 5px;
  border-radius: 4px;
  background: #f7f9fd;
  color: #2f415f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.45;
  vertical-align: middle;
}

.handoff-dashboard-list {
  display: grid;
  gap: 7px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.handoff-dashboard-list li {
  display: grid;
  gap: 3px;
  padding: 7px 9px;
  border-radius: 6px;
  background: #f7f9fd;
}

.handoff-dashboard-list b {
  color: #10233f;
  font-size: 12px;
}

.handoff-dashboard-list span {
  color: #53657f;
  font-size: 11px;
  line-height: 1.45;
}

.github-launch-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
