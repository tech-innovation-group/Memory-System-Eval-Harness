  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.handoff-audit-card strong,
.handoff-audit-card p,
.handoff-audit-card li {
  min-width: 0;
  overflow-wrap: anywhere;
}

.handoff-audit-card strong {
  color: #10233f;
  font-size: 14px;
  line-height: 1.45;
}

.handoff-audit-card p {
  margin: 0;
  color: #53657f;
  font-size: 12px;
  line-height: 1.55;
}

.handoff-audit-card ul {
  display: grid;
  gap: 4px;
  margin: 0;
  padding: 0;
